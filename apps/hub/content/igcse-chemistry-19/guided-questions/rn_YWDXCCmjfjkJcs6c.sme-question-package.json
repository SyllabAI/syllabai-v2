  "packageId": "igcse-chemistry::rn_YWDXCCmjfjkJcs6c",
  "subject": "igcse-chemistry",
  "questions": [
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L1::Q1",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L1",
      "stem": "What colour change shows water is present?",
      "misconceptionClass": "colour direction",
      "options": [
        {
          "key": "A",
          "text": "White anhydrous copper(II) sulfate turns blue",
          "correct": true,
          "explanation": "White to blue is the positive water result.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Blue copper(II) sulfate turns white",
          "correct": false,
          "explanation": "That is the reverse change, which would mean water leaving.",
          "misconception": "direction reversed"
        },
        {
          "key": "C",
          "text": "White litmus turns red",
          "correct": false,
          "explanation": "Litmus belongs to acid-alkali and gas tests, not to this one.",
          "misconception": "litmus test intrudes"
        },
        {
          "key": "D",
          "text": "The powder dissolves colourlessly",
          "correct": false,
          "explanation": "The observation is the blue colour, not a colourless solution.",
          "misconception": "dissolving confused with testing"
        }
      ]
    },
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L1::Q2",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L1",
      "stem": "How many water molecules join one copper(II) sulfate unit?",
      "misconceptionClass": "stoichiometry recall",
      "options": [
        {
          "key": "A",
          "text": "5",
          "correct": true,
          "explanation": "Five waters give the .5H2O in the hydrated formula.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "2",
          "correct": false,
          "explanation": "Two waters would not match the known hydrated formula.",
          "misconception": "subscript confusion"
        },
        {
          "key": "C",
          "text": "1",
          "correct": false,
          "explanation": "One water undercounts the five held in the crystal.",
          "misconception": "single water assumed"
        },
        {
          "key": "D",
          "text": "10",
          "correct": false,
          "explanation": "Ten doubles the correct count.",
          "misconception": "doubling error"
        }
      ]
    },
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L1::Q3",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L1",
      "stem": "What is the formula of the hydrated product?",
      "misconceptionClass": "formula recall",
      "options": [
        {
          "key": "A",
          "text": "CuSO4.5H2O",
          "correct": true,
          "explanation": "The dot formula shows five waters of crystallisation.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "CuSO4.H2O",
          "correct": false,
          "explanation": "One water is not the true hydrated form.",
          "misconception": "waters undercounted"
        },
        {
          "key": "C",
          "text": "CuSO4",
          "correct": false,
          "explanation": "That is the anhydrous starting salt, not the product.",
          "misconception": "anhydrous form repeated"
        },
        {
          "key": "D",
          "text": "Cu(OH)2",
          "correct": false,
          "explanation": "That is copper(II) hydroxide, a different substance entirely.",
          "misconception": "hydroxide confusion"
        }
      ]
    },
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L1::Q4",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L1",
      "stem": "Why does the powder turn blue?",
      "misconceptionClass": "mechanism understanding",
      "options": [
        {
          "key": "A",
          "text": "Water bonds into the crystal structure of the salt",
          "correct": true,
          "explanation": "Bonded water changes the salt's environment and with it the colour.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The salt dissolves and shows its true colour",
          "correct": false,
          "explanation": "The test works on the solid; dissolving is not the mechanism.",
          "misconception": "dissolution explanation"
        },
        {
          "key": "C",
          "text": "The salt burns in air",
          "correct": false,
          "explanation": "Nothing burns in this test.",
          "misconception": "oxidation fiction"
        },
        {
          "key": "D",
          "text": "The water is boiled away",
          "correct": false,
          "explanation": "Boiling would take water out; the test adds it.",
          "misconception": "opposite process"
        }
      ]
    },
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L1::Q5",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L1",
      "stem": "What is the starting appearance of anhydrous copper(II) sulfate?",
      "misconceptionClass": "starting state recall",
      "options": [
        {
          "key": "A",
          "text": "A white powder",
          "correct": true,
          "explanation": "Anhydrous copper(II) sulfate is white before water arrives.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Blue crystals",
          "correct": false,
          "explanation": "Blue is the colour after hydration, not before.",
          "misconception": "product colour as start"
        },
        {
          "key": "C",
          "text": "A clear liquid",
          "correct": false,
          "explanation": "The reagent is a solid powder.",
          "misconception": "state confusion"
        },
        {
          "key": "D",
          "text": "A green solid",
          "correct": false,
          "explanation": "Green belongs to carbonates and iron(II) compounds, not to this salt.",
          "misconception": "carbonate colour intrudes"
        }
      ]
    },
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L2::Q1",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L2",
      "stem": "What property identifies pure water in the physical test?",
      "misconceptionClass": "purity criterion",
      "options": [
        {
          "key": "A",
          "text": "A boiling point of exactly 100 degrees Celsius",
          "correct": true,
          "explanation": "Exactly 100 is the signature of the pure substance.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "A boiling point above 100",
          "correct": false,
          "explanation": "Above 100 means impurities are present, not purity.",
          "misconception": "impure reading accepted"
        },
        {
          "key": "C",
          "text": "A boiling point below 100",
          "correct": false,
          "explanation": "Below 100 is not the pure-water value either.",
          "misconception": "direction misremembered"
        },
        {
          "key": "D",
          "text": "A fixed colour of exactly blue",
          "correct": false,
          "explanation": "Colour belongs to the chemical test; the physical test measures temperature.",
          "misconception": "tests conflated"
        }
      ]
    },
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L2::Q2",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L2",
      "stem": "What apparatus heats the sample gently?",
      "misconceptionClass": "apparatus recall",
      "options": [
        {
          "key": "A",
          "text": "A boiling tube",
          "correct": true,
          "explanation": "The sample sits in a boiling tube and is heated gently.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "A burette",
          "correct": false,
          "explanation": "A burette delivers volumes in titrations; it does not heat anything.",
          "misconception": "titration apparatus intrudes"
        },
        {
          "key": "C",
          "text": "A crucible over a fierce flame",
          "correct": false,
          "explanation": "Fierce heating is contrary to the gentle method described.",
          "misconception": "heating strength wrong"
        },
        {
          "key": "D",
          "text": "A freezer",
          "correct": false,
          "explanation": "The physical test can be run from the melting side, but boiling needs heat, not cold.",
          "misconception": "opposite treatment"
        }
      ]
    },
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L2::Q3",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L2",
      "stem": "What does an impurity do to the boiling point of water?",
      "misconceptionClass": "impurity effect on boiling",
      "options": [
        {
          "key": "A",
          "text": "Raises it",
          "correct": true,
          "explanation": "Dissolved impurities push the boiling point above 100.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Lowers it",
          "correct": false,
          "explanation": "Lowering is what happens to the melting point, not the boiling point.",
          "misconception": "direction reversed"
        },
        {
          "key": "C",
          "text": "Leaves it unchanged",
          "correct": false,
          "explanation": "An unchanged reading is exactly the pure-water result.",
          "misconception": "impurity dismissed"
        },
        {
          "key": "D",
          "text": "Makes it fluctuate wildly",
          "correct": false,
          "explanation": "Impurities shift the value steadily, not erratically.",
          "misconception": "invented behaviour"
        }
      ]
    },
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L2::Q4",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L2",
      "stem": "What does an impurity do to the melting point?",
      "misconceptionClass": "impurity effect on melting",
      "options": [
        {
          "key": "A",
          "text": "Depresses it",
          "correct": true,
          "explanation": "Impurities lower the temperature at which the solid melts.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Raises it",
          "correct": false,
          "explanation": "Raising belongs to the boiling point; melting goes the other way.",
          "misconception": "direction reversed"
        },
        {
          "key": "C",
          "text": "Has no effect",
          "correct": false,
          "explanation": "The source states the melting point is depressed by impurities.",
          "misconception": "impurity dismissed"
        },
        {
          "key": "D",
          "text": "Freezes it instantly",
          "correct": false,
          "explanation": "Freezing is a process, not an effect on the melting point value.",
          "misconception": "absurd effect"
        }
      ]
    },
    {
      "id": "rn_YWDXCCmjfjkJcs6c::L2::Q5",
      "moduleId": "rn_YWDXCCmjfjkJcs6c::L2",
      "stem": "Why is tasting a liquid never an acceptable water test?",
      "misconceptionClass": "safety versus convenience",
      "options": [
        {
          "key": "A",
          "text": "Tasting in a laboratory is hazardous and many colourless liquids taste of nothing",
          "correct": true,
          "explanation": "Both the hazard and the uselessness of taste make it unacceptable.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Water is the only liquid with no taste",
          "correct": false,
          "explanation": "Several colourless liquids share that blandness, which is why taste cannot identify water.",
          "misconception": "false exclusivity"
        },
        {
          "key": "C",
          "text": "Taste changes with the weather",
          "correct": false,
          "explanation": "Weather is irrelevant to the objection.",
          "misconception": "invented variable"
        },
        {
          "key": "D",
          "text": "Taste only works on hot samples",
          "correct": false,
          "explanation": "Temperature is not the issue at all.",
          "misconception": "invented condition"
        }
      ]
    }
  ]
}
