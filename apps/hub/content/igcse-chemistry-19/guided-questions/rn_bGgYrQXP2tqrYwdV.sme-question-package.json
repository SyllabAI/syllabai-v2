    "pinnedRef": "4d857c472fd725597ac21db189542c8f12c82dba"
  },
  "packageId": "igcse-chemistry::rn_bGgYrQXP2tqrYwdV",
  "subject": "igcse-chemistry",
  "questions": [
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L1::Q1",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L1",
      "stem": "How many different monomers build a condensation polymer?",
      "misconceptionClass": "monomer count",
      "options": [
        {
          "key": "A",
          "text": "Two",
          "correct": true,
          "explanation": "One two-ended acid and one two-ended alcohol alternate down the chain.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "One",
          "correct": false,
          "explanation": "A single monomer type describes addition polymers, not these.",
          "misconception": "mechanisms crossed"
        },
        {
          "key": "C",
          "text": "Three or more",
          "correct": false,
          "explanation": "The spec case is exactly two monomers reacting together.",
          "misconception": "count invented"
        },
        {
          "key": "D",
          "text": "Hundreds of types mixed at random",
          "correct": false,
          "explanation": "The chain is orderly and alternating, not a random blend.",
          "misconception": "order denied"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L1::Q2",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L1",
      "stem": "Which small molecule is released as the monomers link?",
      "misconceptionClass": "product identification",
      "options": [
        {
          "key": "A",
          "text": "Water",
          "correct": true,
          "explanation": "An -H from one end and an -OH from the other combine and leave as water.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Carbon dioxide",
          "correct": false,
          "explanation": "No carbonate is involved, so no carbon dioxide is released.",
          "misconception": "gas invented"
        },
        {
          "key": "C",
          "text": "Hydrogen gas",
          "correct": false,
          "explanation": "The hydrogens leave inside water, not as hydrogen gas.",
          "misconception": "product misread"
        },
        {
          "key": "D",
          "text": "Oxygen gas",
          "correct": false,
          "explanation": "Oxygen atoms leave inside the water molecule, not as free gas.",
          "misconception": "product misread"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L1::Q3",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L1",
      "stem": "How many functional groups does each monomer carry?",
      "misconceptionClass": "structure recall",
      "options": [
        {
          "key": "A",
          "text": "Two, one at each end",
          "correct": true,
          "explanation": "Two-ended monomers are what allow the long alternating chain to grow.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "One, in the middle",
          "correct": false,
          "explanation": "A single group could never join two neighbours at once.",
          "misconception": "geometry misread"
        },
        {
          "key": "C",
          "text": "None",
          "correct": false,
          "explanation": "The reacting groups are the whole point of the mechanism.",
          "misconception": "groups denied"
        },
        {
          "key": "D",
          "text": "Four or more",
          "correct": false,
          "explanation": "Crosslinking networks are a different idea; here each monomer carries two.",
          "misconception": "count invented"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L1::Q4",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L1",
      "stem": "Which extra product distinguishes condensation from addition polymer formation?",
      "misconceptionClass": "mechanism contrast",
      "options": [
        {
          "key": "A",
          "text": "A water molecule per linkage",
          "correct": true,
          "explanation": "Every new bond pays for itself with one small water molecule.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Hydrogen chloride every time",
          "correct": false,
          "explanation": "The spec case pairs a dicarboxylic acid with a diol, releasing water.",
          "misconception": "product swapped"
        },
        {
          "key": "C",
          "text": "Carbon dioxide",
          "correct": false,
          "explanation": "No decarboxylation occurs in this polymer route.",
          "misconception": "product invented"
        },
        {
          "key": "D",
          "text": "None, both routes share products",
          "correct": false,
          "explanation": "The second product is exactly what separates the two mechanisms.",
          "misconception": "difference denied"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L1::Q5",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L1",
      "stem": "What joins the monomers in a polyester chain?",
      "misconceptionClass": "linkage identification",
      "options": [
        {
          "key": "A",
          "text": "Ester linkages",
          "correct": true,
          "explanation": "Each acid-alcohol pair clips together through the -COO- ester link.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Carbon-carbon double bonds",
          "correct": false,
          "explanation": "Double bonds belong to the alkene monomers of addition polymers.",
          "misconception": "routes crossed"
        },
        {
          "key": "C",
          "text": "Ionic bonds",
          "correct": false,
          "explanation": "The chain is held together covalently throughout.",
          "misconception": "bonding misread"
        },
        {
          "key": "D",
          "text": "Hydrogen bonds only",
          "correct": false,
          "explanation": "Hydrogen bonding may occur between chains but does not build them.",
          "misconception": "force confused with bond"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L2::Q1",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L2",
      "stem": "What is terylene?",
      "misconceptionClass": "material identification",
      "options": [
        {
          "key": "A",
          "text": "A polyester made from a dicarboxylic acid and a diol",
          "correct": true,
          "explanation": "The named example of the condensation route in this specification.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "An addition polymer of ethene",
          "correct": false,
          "explanation": "That describes polyethene, a different polymer from a different mechanism.",
          "misconception": "routes crossed"
        },
        {
          "key": "C",
          "text": "A carboxylic acid",
          "correct": false,
          "explanation": "Terylene is the polymer built from the acid, not the acid itself.",
          "misconception": "level confused"
        },
        {
          "key": "D",
          "text": "A diol",
          "correct": false,
          "explanation": "The diol is one of its monomers, not the product.",
          "misconception": "reactant confused"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L2::Q2",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L2",
      "stem": "When an ester link forms, from where does the -OH of the released water come?",
      "misconceptionClass": "mechanism detail",
      "options": [
        {
          "key": "A",
          "text": "From the -COOH group of the dicarboxylic acid",
          "correct": true,
          "explanation": "The acid side surrenders its hydroxyl when the link closes.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "From the diol",
          "correct": false,
          "explanation": "The diol side contributes the H instead.",
          "misconception": "donors swapped"
        },
        {
          "key": "C",
          "text": "From the surrounding air",
          "correct": false,
          "explanation": "The water is assembled entirely from the two monomers.",
          "misconception": "source invented"
        },
        {
          "key": "D",
          "text": "From a catalyst",
          "correct": false,
          "explanation": "No catalyst supplies atoms to the product here.",
          "misconception": "role invented"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L2::Q3",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L2",
      "stem": "And from where does the -H of the released water come?",
      "misconceptionClass": "mechanism detail",
      "options": [
        {
          "key": "A",
          "text": "From the -OH group of the diol",
          "correct": true,
          "explanation": "The alcohol side gives up a hydrogen to build the water.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "From the acid's -COOH",
          "correct": false,
          "explanation": "The acid has already given its -OH; its remaining hydrogen stays on the carboxyl carbon.",
          "misconception": "donors swapped"
        },
        {
          "key": "C",
          "text": "From the ester link",
          "correct": false,
          "explanation": "The link is what forms after the water has left.",
          "misconception": "order reversed"
        },
        {
          "key": "D",
          "text": "From the air",
          "correct": false,
          "explanation": "Nothing is borrowed from the atmosphere in this reaction.",
          "misconception": "source invented"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L2::Q4",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L2",
      "stem": "What is hydrolysis?",
      "misconceptionClass": "process definition",
      "options": [
        {
          "key": "A",
          "text": "Adding water to break the polyester back into its monomers",
          "correct": true,
          "explanation": "It is the exact reverse of the condensation that built the chain.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Removing water to join monomers",
          "correct": false,
          "explanation": "That is the condensation step itself, not its reversal.",
          "misconception": "direction reversed"
        },
        {
          "key": "C",
          "text": "Burning the polymer in air",
          "correct": false,
          "explanation": "Burning is combustion, a completely different process.",
          "misconception": "process crossed"
        },
        {
          "key": "D",
          "text": "Freezing the polymer until it cracks",
          "correct": false,
          "explanation": "No freezing is involved in this chemical reversal.",
          "misconception": "process invented"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L2::Q5",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L2",
      "stem": "Which bond is broken first when deducing the monomers from a polyester?",
      "misconceptionClass": "method recall",
      "options": [
        {
          "key": "A",
          "text": "The C-O single bond in each ester link",
          "correct": true,
          "explanation": "Cutting there separates the acid-derived and alcohol-derived sections cleanly.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The C=O double bond",
          "correct": false,
          "explanation": "The double bond stays intact; only the single C-O is cut.",
          "misconception": "bond mischosen"
        },
        {
          "key": "C",
          "text": "The carbon-carbon bonds of the chain",
          "correct": false,
          "explanation": "Cutting the backbone would shred the monomers, not recover them.",
          "misconception": "backbone attacked"
        },
        {
          "key": "D",
          "text": "The O-H bonds of the added water",
          "correct": false,
          "explanation": "The water is the tool, not the thing being cut.",
          "misconception": "tool confused with target"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L3::Q1",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L3",
      "stem": "Which raw materials are biopolyesters synthesised from?",
      "misconceptionClass": "feedstock recall",
      "options": [
        {
          "key": "A",
          "text": "Sugars and plant oils",
          "correct": true,
          "explanation": "Those renewable feedstocks, processed by microbes, build the green polymers.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Crude oil only",
          "correct": false,
          "explanation": "Oil-based feedstocks describe ordinary polymers, not the biopolyester family.",
          "misconception": "feedstock crossed"
        },
        {
          "key": "C",
          "text": "Limestone and sea water",
          "correct": false,
          "explanation": "Neither mineral source appears in the biopolyester recipe.",
          "misconception": "source invented"
        },
        {
          "key": "D",
          "text": "Recycled addition polymers",
          "correct": false,
          "explanation": "Recycling is a disposal strategy, not the synthesis route here.",
          "misconception": "routes crossed"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L3::Q2",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L3",
      "stem": "Which agents assemble biopolyesters from their feedstocks?",
      "misconceptionClass": "agent recall",
      "options": [
        {
          "key": "A",
          "text": "Micro-organisms",
          "correct": true,
          "explanation": "The microbes carry out the synthesis alongside their usual chemistry.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "High pressure alone",
          "correct": false,
          "explanation": "Pressure is not the named agent of this synthesis.",
          "misconception": "agent invented"
        },
        {
          "key": "C",
          "text": "Electric currents",
          "correct": false,
          "explanation": "Electrolysis plays no part in building these chains.",
          "misconception": "agent invented"
        },
        {
          "key": "D",
          "text": "Open flames",
          "correct": false,
          "explanation": "Flames destroy organic feedstocks rather than polymerising them.",
          "misconception": "agent invented"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L3::Q3",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L3",
      "stem": "Which functional groups do biopolyester chains contain?",
      "misconceptionClass": "structure recall",
      "options": [
        {
          "key": "A",
          "text": "Ester, amide and ether groups",
          "correct": true,
          "explanation": "That trio is what gives the polymers their biodegradable character.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Ester groups only",
          "correct": false,
          "explanation": "The chain mixes three kinds of group, not one.",
          "misconception": "list truncated"
        },
        {
          "key": "C",
          "text": "Carbonate and carbide groups",
          "correct": false,
          "explanation": "Neither group belongs to this family.",
          "misconception": "groups invented"
        },
        {
          "key": "D",
          "text": "Silane and siloxane groups",
          "correct": false,
          "explanation": "Those belong to silicon chemistry, far from polyesters.",
          "misconception": "groups invented"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L3::Q4",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L3",
      "stem": "Which property separates biopolyesters from ordinary polyesters?",
      "misconceptionClass": "property contrast",
      "options": [
        {
          "key": "A",
          "text": "They are biodegradable",
          "correct": true,
          "explanation": "That single word is the spec's whole point for this family.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "They conduct electricity",
          "correct": false,
          "explanation": "Conductivity is not the distinguishing property here.",
          "misconception": "property invented"
        },
        {
          "key": "C",
          "text": "They are magnetic",
          "correct": false,
          "explanation": "Magnetism plays no part in the distinction.",
          "misconception": "property invented"
        },
        {
          "key": "D",
          "text": "They melt at zero degrees",
          "correct": false,
          "explanation": "No melting point claim is made in the spec.",
          "misconception": "property invented"
        }
      ]
    },
    {
      "id": "rn_bGgYrQXP2tqrYwdV::L3::Q5",
      "moduleId": "rn_bGgYrQXP2tqrYwdV::L3",
      "stem": "Which statement matches the specification exactly?",
      "misconceptionClass": "spec statement",
      "options": [
        {
          "key": "A",
          "text": "Some polyesters, known as biopolyesters, are biodegradable",
          "correct": true,
          "explanation": "The word some is load-bearing: only the biopolyester branch degrades.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "All polyesters are biodegradable",
          "correct": false,
          "explanation": "Overclaiming drops the qualifier that keeps the statement true.",
          "misconception": "scope widened"
        },
        {
          "key": "C",
          "text": "No polyester is biodegradable",
          "correct": false,
          "explanation": "The biopolyester branch is the counterexample that survives.",
          "misconception": "scope narrowed"
        },
        {
          "key": "D",
          "text": "Biopolyesters are addition polymers",
          "correct": false,
          "explanation": "They belong to the condensation family discussed in this note.",
          "misconception": "family crossed"
        }
      ]
    }
  ]
}
