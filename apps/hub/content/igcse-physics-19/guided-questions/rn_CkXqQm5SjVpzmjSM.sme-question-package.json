      ],
      "options": []
    },
    {
      "id": "rn_CkXqQm5SjVpzmjSM::L2::Q8",
      "moduleId": "rn_CkXqQm5SjVpzmjSM::L2",
      "stem": "Explain how absolute magnitude makes star comparisons fair.",
      "misconceptionClass": "absolute magnitude",
      "kind": "explain-why",
      "modelAnswer": "It imagines every star moved to the same standard distance from Earth, so distance stops distorting the comparison and brightness differences reflect the stars' real luminosities.",
      "keywords": [
        "standard",
        "distance",
        "luminosities",
        "comparison"
      ],
      "options": []
    },
    {
      "id": "rn_CkXqQm5SjVpzmjSM::L2::Q9",
      "moduleId": "rn_CkXqQm5SjVpzmjSM::L2",
      "stem": "Star A looks dimmer than star B from Earth but has the higher absolute magnitude. State which star is more luminous.",
      "misconceptionClass": "comparison trap",
      "kind": "application",
      "modelAnswer": "Star A is more luminous: at the standard distance its greater power would outshine B, so B only looks brighter because it is nearer.",
      "keywords": [
        "absolute",
        "magnitude",
        "luminous",
        "distance"
      ],
      "options": []
    }
  ]
