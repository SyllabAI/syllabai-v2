  "questions": [
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L1::Q1",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L1",
      "stem": "The distance travelled in one circular orbit equals…",
      "misconceptionClass": "circumference recall",
      "options": [
        {
          "key": "A",
          "text": "the circumference of the orbit, 2πr",
          "correct": true,
          "explanation": "One lap of a circle covers 2πr.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "the orbital radius r",
          "correct": false,
          "explanation": "The radius is one crossing, not the lap.",
          "misconception": "length error"
        },
        {
          "key": "C",
          "text": "the diameter 2r",
          "correct": false,
          "explanation": "The diameter crosses the circle; the lap goes all the way round.",
          "misconception": "length error"
        },
        {
          "key": "D",
          "text": "πr squared",
          "correct": false,
          "explanation": "That is an area formula, not a distance.",
          "misconception": "formula mix-up"
        }
      ]
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L1::Q2",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L1",
      "stem": "In the equation v = 2πr / T, the quantity T is…",
      "misconceptionClass": "symbol recall",
      "options": [
        {
          "key": "A",
          "text": "the circumference in metres",
          "correct": false,
          "explanation": "The circumference is 2πr.",
          "misconception": "symbol swap"
        },
        {
          "key": "B",
          "text": "the orbital period, in seconds",
          "correct": true,
          "explanation": "T times one full orbit.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "the orbital radius in metres",
          "correct": false,
          "explanation": "That is r.",
          "misconception": "symbol swap"
        },
        {
          "key": "D",
          "text": "the orbital speed in m/s",
          "correct": false,
          "explanation": "That is v.",
          "misconception": "symbol swap"
        }
      ]
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L1::Q3",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L1",
      "stem": "The orbital radius r is measured from…",
      "misconceptionClass": "radius definition",
      "options": [
        {
          "key": "A",
          "text": "the orbiting object to itself",
          "correct": false,
          "explanation": "That is meaningless.",
          "misconception": "nonsense option"
        },
        {
          "key": "B",
          "text": "the orbited body's north pole only",
          "correct": false,
          "explanation": "The measurement is centre-to-object, not pole-specific.",
          "misconception": "radius error"
        },
        {
          "key": "C",
          "text": "the centre of the orbited body to the orbiting object",
          "correct": true,
          "explanation": "The radius starts at the centre, not the surface.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "the surface of the orbited body",
          "correct": false,
          "explanation": "Surface height must be added to the body's radius first.",
          "misconception": "radius error"
        }
      ]
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L1::Q4",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L1",
      "stem": "If the orbital period T doubles while r stays fixed, the orbital speed…",
      "misconceptionClass": "equation reasoning",
      "options": [
        {
          "key": "A",
          "text": "doubles",
          "correct": false,
          "explanation": "Speed and period move oppositely here.",
          "misconception": "direction error"
        },
        {
          "key": "B",
          "text": "stays the same",
          "correct": false,
          "explanation": "Changing T with fixed r must change v.",
          "misconception": "no effect myth"
        },
        {
          "key": "C",
          "text": "quadruples",
          "correct": false,
          "explanation": "There is no squaring in this relation.",
          "misconception": "arithmetic error"
        },
        {
          "key": "D",
          "text": "halves, because v = 2πr / T",
          "correct": true,
          "explanation": "T sits in the denominator, so speed falls as T grows.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L1::Q5",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L1",
      "stem": "The orbital period is defined as…",
      "misconceptionClass": "period definition",
      "options": [
        {
          "key": "A",
          "text": "the duration of one full orbit",
          "correct": true,
          "explanation": "One lap's worth of time.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "the distance around the orbit",
          "correct": false,
          "explanation": "That is the circumference.",
          "misconception": "definition swap"
        },
        {
          "key": "C",
          "text": "the speed along the orbit",
          "correct": false,
          "explanation": "That is the orbital speed.",
          "misconception": "definition swap"
        },
        {
          "key": "D",
          "text": "the radius of the orbit",
          "correct": false,
          "explanation": "That is r.",
          "misconception": "definition swap"
        }
      ]
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L1::Q6",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L1",
      "stem": "Write the equation linking orbital speed, orbital radius and time period.",
      "misconceptionClass": "equation recall",
      "kind": "recall",
      "modelAnswer": "Orbital speed v = 2πr / T, where r is the orbital radius and T the time period.",
      "keywords": [
        "orbital",
        "speed",
        "radius",
        "period"
      ],
      "options": []
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L1::Q7",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L1",
      "stem": "State what distance an orbiting body covers in one orbit.",
      "misconceptionClass": "circumference recall",
      "kind": "recall",
      "modelAnswer": "It covers the circumference of the circle, equal to 2πr.",
      "keywords": [
        "circumference",
        "circle",
        "orbit",
        "covers"
      ],
      "options": []
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L1::Q8",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L1",
      "stem": "Explain why the orbital speed formula divides 2πr by T.",
      "misconceptionClass": "equation reasoning",
      "kind": "explain-why",
      "modelAnswer": "Speed is distance divided by time; in one orbit the distance is the circumference 2πr and the time is the period T, so the average orbital speed must be 2πr divided by T.",
      "keywords": [
        "speed",
        "distance",
        "circumference",
        "period"
      ],
      "options": []
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L1::Q9",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L1",
      "stem": "A satellite orbits at radius 7,000 km (7,000,000 m) with a period of 6,000 s. Calculate its orbital speed.",
      "misconceptionClass": "speed calculation",
      "kind": "application",
      "modelAnswer": "v = 2πr / T = (2 × π × 7,000,000) / 6,000 ≈ 43,982,297 / 6,000 ≈ 7,330 m/s (3 s.f.).",
      "keywords": [
        "orbital",
        "speed",
        "radius",
        "period"
      ],
      "options": []
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L2::Q1",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L2",
      "stem": "Hubble orbits 560 km above a 6400 km Earth. Its orbital radius is…",
      "misconceptionClass": "radius building",
      "options": [
        {
          "key": "A",
          "text": "6960 m",
          "correct": false,
          "explanation": "The value is kilometres, not metres.",
          "misconception": "unit error"
        },
        {
          "key": "B",
          "text": "6400 + 560 = 6960 km",
          "correct": true,
          "explanation": "Radius runs from Earth's centre: add the surface radius and the altitude.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "560 km",
          "correct": false,
          "explanation": "That is the altitude above the surface only.",
          "misconception": "radius error"
        },
        {
          "key": "D",
          "text": "6400 km",
          "correct": false,
          "explanation": "That is Earth's radius without the altitude.",
          "misconception": "radius error"
        }
      ]
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L2::Q2",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L2",
      "stem": "Hubble's 96-minute period converts to…",
