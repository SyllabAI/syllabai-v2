        {
          "key": "A",
          "text": "96 s",
          "correct": false,
          "explanation": "Minutes must be multiplied by 60.",
          "misconception": "conversion error"
        },
        {
          "key": "B",
          "text": "576,000 s",
          "correct": false,
          "explanation": "That multiplies by an extra hundred.",
          "misconception": "conversion error"
        },
        {
          "key": "C",
          "text": "5760 s",
          "correct": true,
          "explanation": "96 × 60 = 5760 seconds.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "960 s",
          "correct": false,
          "explanation": "That drops a factor of six.",
          "misconception": "conversion error"
        }
      ]
    },
    {
      "id": "rn_vVJjCmGbcDY2Ck9G::L2::Q3",
      "moduleId": "rn_vVJjCmGbcDY2Ck9G::L2",
      "stem": "With r = 6,960,000 m and T = 5760 s, Hubble's speed is about…",
