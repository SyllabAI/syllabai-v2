      "options": [
        {
          "key": "A",
          "text": "759 m/s",
          "correct": false,
          "explanation": "A factor of ten low.",
          "misconception": "arithmetic error"
        },
        {
          "key": "B",
          "text": "75,900 m/s",
          "correct": false,
          "explanation": "A factor of ten high.",
          "misconception": "arithmetic error"
        },
        {
          "key": "C",
          "text": "6960 m/s",
          "correct": false,
          "explanation": "That substitutes the radius where the speed belongs.",
          "misconception": "substitution error"
        },
        {
          "key": "D",
          "text": "7590 m/s",
          "correct": true,
          "explanation": "2π × 6,960,000 / 5760 ≈ 7592, quoted as 7590 to 3 s.f.",
          "misconception": null
