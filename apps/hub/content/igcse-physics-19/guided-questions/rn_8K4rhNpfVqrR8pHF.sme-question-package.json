    {
      "id": "rn_8K4rhNpfVqrR8pHF::L1::Q8",
      "moduleId": "rn_8K4rhNpfVqrR8pHF::L1",
      "stem": "Explain why microwaves can heat food but radio waves used for broadcasting are not used to cook.",
      "misconceptionClass": "evaluation reasoning",
      "kind": "explain-why",
      "modelAnswer": "Microwaves at high intensity couple strongly to water in food and deposit energy as heat, while the broadcast band is chosen and regulated to carry signals without depositing useful heating energy in its surroundings.",
