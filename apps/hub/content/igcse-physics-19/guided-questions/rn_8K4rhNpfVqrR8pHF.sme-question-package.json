    {
      "id": "rn_8K4rhNpfVqrR8pHF::L1::Q1",
      "moduleId": "rn_8K4rhNpfVqrR8pHF::L1",
      "stem": "Which radiations carry broadcasting and communications?",
      "misconceptionClass": "uses table",
      "options": [
        {
          "key": "A",
          "text": "gamma rays",
          "correct": false,
          "explanation": "Gamma sterilises; it does not broadcast.",
          "misconception": "band mix-up"
        },
        {
          "key": "B",
          "text": "radio waves",
          "correct": true,
          "explanation": "Broadcasting and communications are the radio band uses.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "ultraviolet",
          "correct": false,
          "explanation": "Ultraviolet drives fluorescent lamps.",
          "misconception": "band mix-up"
        },
        {
          "key": "D",
          "text": "x-rays",
          "correct": false,
          "explanation": "X-rays image internal structure.",
          "misconception": "band mix-up"
        }
      ]
    },
    {
      "id": "rn_8K4rhNpfVqrR8pHF::L1::Q2",
      "moduleId": "rn_8K4rhNpfVqrR8pHF::L1",
      "stem": "Microwaves are used for cooking and for:",
      "misconceptionClass": "uses table",
      "options": [
        {
          "key": "A",
          "text": "fluorescent lamps",
          "correct": false,
          "explanation": "That is the ultraviolet use.",
          "misconception": "band mix-up"
        },
        {
          "key": "B",
          "text": "sterilising food",
          "correct": false,
          "explanation": "Sterilising is the gamma use.",
          "misconception": "band mix-up"
        },
        {
          "key": "C",
          "text": "satellite transmissions",
          "correct": true,
          "explanation": "Satellite links share the microwave band with ovens.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "night vision",
          "correct": false,
          "explanation": "Night vision belongs to infrared.",
          "misconception": "band mix-up"
        }
      ]
    },
    {
      "id": "rn_8K4rhNpfVqrR8pHF::L1::Q3",
      "moduleId": "rn_8K4rhNpfVqrR8pHF::L1",
      "stem": "Night-vision security cameras see people in the dark because they detect:",
      "misconceptionClass": "uses table",
      "options": [
        {
          "key": "A",
          "text": "radio waves from the person",
          "correct": false,
          "explanation": "People do not broadcast radio.",
          "misconception": "band mix-up"
        },
        {
          "key": "B",
          "text": "x-rays passed through the person",
          "correct": false,
          "explanation": "X-ray imaging needs a source and dose, not passive body heat.",
          "misconception": "band mix-up"
        },
        {
          "key": "C",
          "text": "gamma rays",
          "correct": false,
          "explanation": "Gamma is far too energetic for body-heat imaging.",
          "misconception": "band mix-up"
        },
        {
          "key": "D",
          "text": "infrared emitted by warm bodies",
          "correct": true,
          "explanation": "Thermal imaging works in infrared, which warm objects emit.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_8K4rhNpfVqrR8pHF::L1::Q4",
      "moduleId": "rn_8K4rhNpfVqrR8pHF::L1",
      "stem": "Fluorescent lamps work because their coating absorbs ultraviolet and:",
      "misconceptionClass": "uses table",
      "options": [
        {
          "key": "A",
          "text": "re-emits the energy as visible light",
          "correct": true,
          "explanation": "Fluorescence converts absorbed ultraviolet into visible emission.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "reflects it unchanged",
          "correct": false,
          "explanation": "The lamp process is absorption and re-emission, not reflection.",
          "misconception": "mechanism swap"
        },
        {
          "key": "C",
          "text": "stores it permanently",
          "correct": false,
          "explanation": "The energy is re-emitted, not banked.",
          "misconception": "storage myth"
        },
        {
          "key": "D",
          "text": "destroys it",
          "correct": false,
          "explanation": "Energy is converted, never destroyed.",
          "misconception": "conservation myth"
        }
      ]
    },
    {
