      "misconceptionClass": "uses table",
      "options": [
        {
          "key": "A",
          "text": "infrared",
          "correct": false,
          "explanation": "Infrared heats; it is not the sterilising band here.",
          "misconception": "band mix-up"
        },
        {
          "key": "B",
          "text": "radio waves",
          "correct": false,
          "explanation": "Radio carries signals, not sterilisation.",
          "misconception": "band mix-up"
        },
        {
          "key": "C",
          "text": "gamma rays",
          "correct": true,
          "explanation": "Gamma kills bacteria, so it sterilises food and equipment.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "visible light",
          "correct": false,
          "explanation": "Visible light photographs and illuminates.",
          "misconception": "band mix-up"
        }
      ]
    },
