          "text": "nothing until they are red hot",
          "correct": false,
          "explanation": "All warm objects radiate something.",
          "misconception": "absolutism error"
        },
        {
          "key": "B",
          "text": "infrared radiation",
          "correct": true,
          "explanation": "Warm bodies radiate infrared; hotter ones add visible light.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "gamma rays",
          "correct": false,
          "explanation": "Gamma emission needs nuclear-scale energies.",
          "misconception": "spectrum error"
        },
        {
          "key": "D",
          "text": "radio waves only",
          "correct": false,
          "explanation": "Radio is the low-energy end, not the warm-body band.",
          "misconception": "spectrum error"
        }
      ]
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L2::Q2",
      "moduleId": "rn_brvXTR6qywMXZxJR::L2",
      "stem": "As a red giant forms, the star's surface…",
