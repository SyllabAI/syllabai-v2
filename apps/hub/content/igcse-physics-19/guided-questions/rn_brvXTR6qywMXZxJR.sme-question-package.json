          "correct": false,
          "explanation": "Distance changes brightness, not emitted colour.",
          "misconception": "quantity swap"
        },
        {
          "key": "B",
          "text": "its chemical paint",
          "correct": false,
          "explanation": "Stars are not painted.",
          "misconception": "nonsense option"
        },
        {
          "key": "C",
          "text": "the size of its planets",
          "correct": false,
          "explanation": "Planets are irrelevant here.",
          "misconception": "nonsense option"
        },
        {
          "key": "D",
          "text": "how hot the star is",
          "correct": true,
          "explanation": "Temperature decides the emitted colour.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L2::Q4",
      "moduleId": "rn_brvXTR6qywMXZxJR::L2",
      "stem": "A white dwarf whitens because it…",
