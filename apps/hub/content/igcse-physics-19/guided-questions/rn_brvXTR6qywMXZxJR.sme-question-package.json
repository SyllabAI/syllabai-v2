      "options": []
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L1::Q8",
      "moduleId": "rn_brvXTR6qywMXZxJR::L1",
      "stem": "Explain why a star's colour changes as it expands or contracts.",
      "misconceptionClass": "expansion cooling",
      "kind": "explain-why",
      "modelAnswer": "A star's colour is set by its surface temperature; astronomical objects shrink-and-warm while swell-and-cool, so expansion reddens the star while contraction whitens it.",
      "keywords": [
        "colour",
        "temperature",
        "expand",
        "contract"
      ],
      "options": []
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L1::Q9",
      "moduleId": "rn_brvXTR6qywMXZxJR::L1",
      "stem": "Two stars are observed: one red, one blue. Rank their surface temperatures and justify with the corpus values.",
      "misconceptionClass": "colour temperature",
      "kind": "application",
      "modelAnswer": "The blue star is hotter: red sits near 3000 K while blue reaches about 30 000 K, ten times hotter.",
      "keywords": [
        "blue",
        "hotter",
        "red",
        "temperature"
      ],
      "options": []
    },
    {
