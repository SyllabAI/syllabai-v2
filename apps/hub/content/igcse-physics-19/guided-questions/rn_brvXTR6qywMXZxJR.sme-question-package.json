      "options": [
        {
          "key": "A",
          "text": "stays at the same temperature",
          "correct": false,
          "explanation": "The surface temperature drops.",
          "misconception": "constancy myth"
        },
        {
          "key": "B",
          "text": "turns blue from the pressure",
          "correct": false,
          "explanation": "Blue is the hot signature.",
          "misconception": "colour inversion"
