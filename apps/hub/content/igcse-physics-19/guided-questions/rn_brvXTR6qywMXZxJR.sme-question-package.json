  "questions": [
    {
      "id": "rn_brvXTR6qywMXZxJR::L1::Q1",
      "moduleId": "rn_brvXTR6qywMXZxJR::L1",
      "stem": "Which stars are the hottest?",
      "misconceptionClass": "colour temperature",
      "options": [
        {
          "key": "A",
          "text": "blue stars",
          "correct": true,
          "explanation": "Blue signals the highest surface temperatures.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "red stars",
          "correct": false,
          "explanation": "Red is the coolest class.",
          "misconception": "colour inversion"
        },
        {
          "key": "C",
          "text": "yellow stars like the Sun",
          "correct": false,
          "explanation": "Yellow sits between the extremes.",
          "misconception": "middle error"
        },
        {
          "key": "D",
          "text": "white stars",
          "correct": false,
          "explanation": "White is hot but blue is hotter.",
          "misconception": "ordering error"
        }
      ]
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L1::Q2",
      "moduleId": "rn_brvXTR6qywMXZxJR::L1",
      "stem": "A red star's surface temperature is roughly…",
      "misconceptionClass": "temperature values",
      "options": [
        {
          "key": "A",
          "text": "3 000 000 K",
          "correct": false,
          "explanation": "A thousand times too hot.",
          "misconception": "scale error"
        },
        {
          "key": "B",
          "text": "3000 K",
          "correct": true,
          "explanation": "Red stars sit near 3000 K.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "30 000 K",
          "correct": false,
          "explanation": "That is the blue-end value.",
          "misconception": "value swap"
        },
        {
          "key": "D",
          "text": "300 K",
          "correct": false,
          "explanation": "Ten times too cool.",
          "misconception": "scale error"
        }
      ]
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L1::Q3",
      "moduleId": "rn_brvXTR6qywMXZxJR::L1",
      "stem": "The everyday intuition that red means hot is, for stars…",
      "misconceptionClass": "colour inversion",
      "options": [
        {
          "key": "A",
          "text": "irrelevant, since colour shows size",
          "correct": false,
          "explanation": "Colour tracks temperature.",
          "misconception": "category error"
        },
        {
          "key": "B",
          "text": "true only for white dwarfs",
          "correct": false,
          "explanation": "The inversion applies across star classes.",
          "misconception": "scope error"
        },
        {
          "key": "C",
          "text": "backwards — red stars are the coolest",
          "correct": true,
          "explanation": "Star colours invert the hot-tap intuition.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "correct — red stars are hottest",
          "correct": false,
          "explanation": "Blue is the hot end for stars.",
          "misconception": "colour inversion"
        }
      ]
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L1::Q4",
      "moduleId": "rn_brvXTR6qywMXZxJR::L1",
      "stem": "When a star expands into a red giant it becomes redder because it…",
      "misconceptionClass": "expansion cooling",
      "options": [
        {
          "key": "A",
          "text": "heats up as it contracts",
          "correct": false,
          "explanation": "Expansion is the opposite of contraction.",
          "misconception": "direction error"
        },
        {
          "key": "B",
          "text": "gains new red fuel",
          "correct": false,
          "explanation": "Colour is physics, not fuel chemistry.",
          "misconception": "nonsense option"
        },
        {
          "key": "C",
          "text": "moves closer to us",
          "correct": false,
          "explanation": "Distance does not change colour class.",
          "misconception": "nonsense option"
        },
        {
          "key": "D",
          "text": "cools as it expands",
          "correct": true,
          "explanation": "Expansion costs temperature, and cooler means redder.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L1::Q5",
      "moduleId": "rn_brvXTR6qywMXZxJR::L1",
      "stem": "A white dwarf is white because it…",
      "misconceptionClass": "contraction heating",
      "options": [
        {
          "key": "A",
          "text": "contracts and heats up, shifting its colour whiter",
          "correct": true,
          "explanation": "Shrinking concentrates energy and raises temperature.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "has expanded and cooled",
          "correct": false,
          "explanation": "That describes the red giant route.",
          "misconception": "stage swap"
        },
        {
          "key": "C",
          "text": "is covered in white gas",
          "correct": false,
          "explanation": "Colour comes from temperature, not coating.",
          "misconception": "nonsense option"
        },
        {
          "key": "D",
          "text": "reflects light from nearby stars",
          "correct": false,
          "explanation": "Stars emit their own light.",
          "misconception": "emission error"
        }
      ]
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L1::Q6",
      "moduleId": "rn_brvXTR6qywMXZxJR::L1",
      "stem": "State how stars can be classified.",
