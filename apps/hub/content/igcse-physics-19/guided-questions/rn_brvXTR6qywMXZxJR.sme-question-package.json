          "correct": false,
          "explanation": "It still emits, just faintly.",
          "misconception": "absolutism error"
        },
        {
          "key": "D",
          "text": "absorbs blue light from space",
          "correct": false,
          "explanation": "Its colour is self-emitted.",
          "misconception": "emission error"
        }
      ]
    },
