        {
          "key": "C",
          "text": "expands and cools, so the star reddens",
          "correct": true,
          "explanation": "Bigger and cooler equals redder.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "contracts and heats, so it whitens",
          "correct": false,
          "explanation": "That is the white dwarf transition.",
          "misconception": "stage swap"
        }
      ]
    },
    {
      "id": "rn_brvXTR6qywMXZxJR::L2::Q3",
      "moduleId": "rn_brvXTR6qywMXZxJR::L2",
