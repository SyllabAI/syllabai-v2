      "misconceptionClass": "energy arithmetic",
      "options": [
        {
          "key": "A",
          "text": "18 J",
          "correct": true,
          "explanation": "E = 2 × 9 = 18 J.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "4.5 J",
          "correct": false,
          "explanation": "That divides voltage by charge instead of multiplying.",
          "misconception": "division slip"
        },
        {
          "key": "C",
          "text": "11 J",
          "correct": false,
          "explanation": "Adding the values is meaningless.",
          "misconception": "addition slip"
        },
        {
          "key": "D",
          "text": "7 J",
          "correct": false,
          "explanation": "Subtracting the values is meaningless here.",
          "misconception": "subtraction slip"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L2::Q5",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L2",
      "stem": "The equation E = Q × V computes which quantity for a lamp?",
      "misconceptionClass": "quantity identification",
      "options": [
        {
          "key": "A",
          "text": "the power it dissipates each second",
          "correct": false,
          "explanation": "Power needs an energy-per-time view, which this equation does not give.",
          "misconception": "quantity swap"
        },
        {
          "key": "B",
          "text": "the current through its filament",
          "correct": false,
          "explanation": "Current is charge per second — a different quantity entirely.",
          "misconception": "quantity swap"
        },
        {
          "key": "C",
          "text": "the total energy it transfers for the given charge",
          "correct": true,
          "explanation": "The equation totals the energy carried by the stated charge at that voltage.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "the resistance of its filament",
          "correct": false,
          "explanation": "Resistance belongs to the voltage-current-resistance equation.",
          "misconception": "quantity swap"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L2::Q6",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L2",
      "stem": "Write down the equation linking energy transferred, charge and voltage.",
      "misconceptionClass": "equation recall",
      "kind": "recall",
      "modelAnswer": "E = Q × V — energy transferred in joules equals the charge in coulombs multiplied by the voltage in volts.",
