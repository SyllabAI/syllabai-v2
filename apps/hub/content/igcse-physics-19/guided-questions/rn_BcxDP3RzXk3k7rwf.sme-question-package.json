    {
      "id": "rn_BcxDP3RzXk3k7rwf::L2::Q9",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L2",
      "stem": "A 12 V motor moves 150 C of charge through itself. Calculate the energy transferred.",
      "misconceptionClass": "energy calculation",
