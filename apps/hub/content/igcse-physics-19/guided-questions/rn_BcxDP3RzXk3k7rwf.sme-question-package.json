  "questions": [
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L1::Q1",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L1",
      "stem": "Voltage is defined as:",
      "misconceptionClass": "definition recall",
      "options": [
        {
          "key": "A",
          "text": "the rate of flow of charge",
          "correct": false,
          "explanation": "That defines current, not voltage.",
          "misconception": "definition swap"
        },
        {
          "key": "B",
          "text": "the energy transferred per unit charge between two points",
          "correct": true,
          "explanation": "Voltage is the energy handed over by each coulomb between two locations.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "the opposition to the flow of charge",
          "correct": false,
          "explanation": "That describes resistance.",
          "misconception": "definition swap"
        },
        {
          "key": "D",
          "text": "the total energy in a circuit",
          "correct": false,
          "explanation": "Voltage is a per-coulomb quantity, not an energy total.",
          "misconception": "quantity slip"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L1::Q2",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L1",
      "stem": "One volt is equivalent to:",
      "misconceptionClass": "unit recall",
      "options": [
        {
          "key": "A",
          "text": "one joule per coulomb",
          "correct": true,
          "explanation": "The volt is defined as a joule of energy transferred per coulomb of charge.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "one coulomb per second",
          "correct": false,
          "explanation": "That combination defines the ampere.",
          "misconception": "unit swap"
        },
        {
          "key": "C",
          "text": "one joule per second",
          "correct": false,
          "explanation": "That combination defines the watt.",
          "misconception": "unit swap"
        },
        {
          "key": "D",
          "text": "one newton per coulomb",
          "correct": false,
          "explanation": "That combination belongs to electric field strength, not voltage.",
          "misconception": "unit mashup"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L1::Q3",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L1",
      "stem": "A voltmeter must be connected:",
      "misconceptionClass": "meter placement",
      "options": [
        {
          "key": "A",
          "text": "in series with the component",
          "correct": false,
          "explanation": "Series placement is for ammeters; a voltmeter in series spoils the reading.",
          "misconception": "placement swap"
        },
        {
          "key": "B",
          "text": "anywhere along the loop",
          "correct": false,
          "explanation": "The meter must span the exact two points whose difference you want.",
          "misconception": "placement myth"
        },
        {
          "key": "C",
          "text": "in parallel across the component",
          "correct": true,
          "explanation": "Voltage is a difference between two points, so the meter bridges them in parallel.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "only at the cell terminals",
          "correct": false,
          "explanation": "A voltmeter can read any component, not just the cell.",
          "misconception": "terminal myth"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L1::Q4",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L1",
      "stem": "In a 12 V cell, each coulomb of charge passing through:",
      "misconceptionClass": "energy gain reasoning",
      "options": [
        {
          "key": "A",
          "text": "gains 12 J of energy",
          "correct": true,
          "explanation": "A 12 V cell gives every coulomb 12 joules of energy.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "gains 12 N of force",
          "correct": false,
          "explanation": "Newtons measure force; the cell hands out energy.",
          "misconception": "quantity slip"
        },
        {
          "key": "C",
          "text": "loses 12 J of energy",
          "correct": false,
          "explanation": "Inside the cell the charge gains energy; it spends it later in the circuit.",
          "misconception": "direction slip"
        },
        {
          "key": "D",
          "text": "gains 12 C of extra charge",
          "correct": false,
          "explanation": "Cells move charge; they do not manufacture it.",
          "misconception": "charge-creation myth"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L1::Q5",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L1",
      "stem": "As electrons flow around the circuit away from the cell, they:",
      "misconceptionClass": "energy transfer reasoning",
      "options": [
        {
          "key": "A",
          "text": "keep gaining energy indefinitely",
          "correct": false,
          "explanation": "Only the cell gives energy out; the rest of the loop takes it.",
          "misconception": "growth myth"
        },
        {
          "key": "B",
          "text": "hold all their energy until they return to the cell",
          "correct": false,
          "explanation": "Components and wires take the energy along the way.",
          "misconception": "conservation slip"
        },
        {
          "key": "C",
          "text": "transfer energy to the components and wires they pass through",
          "correct": true,
          "explanation": "Each coulomb unloads its energy parcel as it travels the loop.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "reverse direction at every component",
          "correct": false,
          "explanation": "The drift keeps one direction around the whole loop.",
          "misconception": "direction myth"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L1::Q6",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L1",
      "stem": "State what voltage measures and give its unit in fundamental units.",
      "misconceptionClass": "definition recall",
      "kind": "recall",
      "modelAnswer": "Voltage measures the energy transferred per unit of charge between two points; one volt is one joule per coulomb.",
      "keywords": [
        "voltage",
        "energy",
        "charge",
        "joule",
        "coulomb"
      ],
      "options": []
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L1::Q7",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L1",
      "stem": "How should a voltmeter be connected when measuring the voltage across a lamp?",
      "misconceptionClass": "meter placement recall",
      "kind": "recall",
      "modelAnswer": "In parallel with the lamp, so the meter spans the same two points as the component.",
      "keywords": [
        "parallel",
        "voltmeter",
        "lamp",
        "component",
        "points"
      ],
      "options": []
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L1::Q8",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L1",
      "stem": "Explain why a voltmeter needs to span two points in a circuit.",
      "misconceptionClass": "definition reasoning",
      "kind": "explain-why",
      "modelAnswer": "Voltage is a difference in energy per coulomb between two locations, so the meter must compare both points — that is why the name potential difference fits it.",
      "keywords": [
        "difference",
        "potential",
        "two",
        "points",
        "voltage"
      ],
      "options": []
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L1::Q9",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L1",
      "stem": "A charge of 25 C passes through a bulb, transferring 200 J of energy. Calculate the voltage across the bulb.",
      "misconceptionClass": "voltage calculation",
      "kind": "application",
      "modelAnswer": "V = E ÷ Q = 200 J ÷ 25 C = 8 V.",
      "keywords": [
        "8",
        "200",
        "25",
        "voltage",
        "energy"
      ],
      "options": []
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L2::Q1",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L2",
      "stem": "The equation linking energy transferred, charge and voltage is:",
      "misconceptionClass": "equation recall",
      "options": [
        {
          "key": "A",
          "text": "E = Q ÷ V",
          "correct": false,
          "explanation": "Dividing energy by voltage gives charge, not energy.",
          "misconception": "operation slip"
        },
        {
          "key": "B",
          "text": "E = Q × V",
          "correct": true,
          "explanation": "Energy transferred is charge multiplied by voltage.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "E = V ÷ Q",
          "correct": false,
          "explanation": "That inverts the relationship.",
          "misconception": "inversion slip"
        },
        {
          "key": "D",
          "text": "E = Q + V",
          "correct": false,
          "explanation": "Different units cannot simply be added.",
          "misconception": "operation slip"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L2::Q2",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L2",
      "stem": "A 6 V lamp has 4200 C of charge flow through it. The energy transferred is:",
      "misconceptionClass": "energy arithmetic",
      "options": [
        {
          "key": "A",
          "text": "700 J",
          "correct": false,
          "explanation": "That divides charge by voltage instead of multiplying.",
          "misconception": "division slip"
        },
        {
          "key": "B",
          "text": "25 200 J",
          "correct": true,
          "explanation": "E = Q × V = 4200 × 6 = 25 200 J.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "4206 J",
          "correct": false,
          "explanation": "Adding the two values is meaningless.",
          "misconception": "addition slip"
        },
        {
          "key": "D",
          "text": "4194 J",
          "correct": false,
          "explanation": "Subtracting the values is meaningless here.",
          "misconception": "subtraction slip"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L2::Q3",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L2",
      "stem": "Rearranging E = Q × V for charge gives:",
      "misconceptionClass": "equation rearrangement",
      "options": [
        {
          "key": "A",
          "text": "Q = E × V",
          "correct": false,
          "explanation": "Multiplying by V moves further from the original equation.",
          "misconception": "operation slip"
        },
        {
          "key": "B",
          "text": "Q = V ÷ E",
          "correct": false,
          "explanation": "That inverts the rearrangement.",
          "misconception": "inversion slip"
        },
        {
          "key": "C",
          "text": "Q = E ÷ V",
          "correct": true,
          "explanation": "Dividing both sides by V isolates the charge.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Q = E + V",
          "correct": false,
          "explanation": "Addition cannot rearrange a product.",
          "misconception": "operation slip"
        }
      ]
    },
    {
      "id": "rn_BcxDP3RzXk3k7rwf::L2::Q4",
      "moduleId": "rn_BcxDP3RzXk3k7rwf::L2",
