    {
      "id": "rn_fw6NFrfWcsgZpNpW::L1::Q1",
      "moduleId": "rn_fw6NFrfWcsgZpNpW::L1",
      "stem": "Weight is defined as…",
      "misconceptionClass": "weight definition",
      "options": [
        {
          "key": "A",
          "text": "the gravitational pull acting on the object",
          "correct": true,
          "explanation": "Weight is a gravitational force, measured in newtons.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "the amount of matter in an object",
          "correct": false,
          "explanation": "That is mass, which stays constant.",
          "misconception": "mass weight swap"
        },
        {
          "key": "C",
          "text": "the object's speed while falling",
          "correct": false,
          "explanation": "Speed is not weight.",
          "misconception": "category error"
        },
        {
          "key": "D",
          "text": "the push of the ground on the object",
          "correct": false,
          "explanation": "That is the normal contact force.",
          "misconception": "force confusion"
        }
      ]
    },
    {
      "id": "rn_fw6NFrfWcsgZpNpW::L1::Q2",
      "moduleId": "rn_fw6NFrfWcsgZpNpW::L1",
      "stem": "Gravitational field strength is greater on a planet with…",
      "misconceptionClass": "g variation",
      "options": [
        {
          "key": "A",
          "text": "a smaller mass",
          "correct": false,
          "explanation": "Smaller mass means weaker gravity.",
          "misconception": "direction error"
        },
        {
          "key": "B",
          "text": "greater mass",
          "correct": true,
          "explanation": "More massive planets attract more strongly per kilogram.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "a faster day length",
          "correct": false,
          "explanation": "Rotation length does not set field strength here.",
          "misconception": "nonsense factor"
        },
        {
          "key": "D",
          "text": "a thinner atmosphere",
          "correct": false,
          "explanation": "Atmosphere thickness is not the driver.",
          "misconception": "nonsense factor"
        }
      ]
    },
    {
      "id": "rn_fw6NFrfWcsgZpNpW::L1::Q3",
      "moduleId": "rn_fw6NFrfWcsgZpNpW::L1",
      "stem": "Compared with Earth, gravitational field strength on the Moon is…",
      "misconceptionClass": "g variation",
      "options": [
        {
          "key": "A",
          "text": "identical, because mass is fixed",
          "correct": false,
          "explanation": "The object's mass is fixed; the field is not.",
          "misconception": "mass weight swap"
        },
        {
          "key": "B",
          "text": "zero, because the Moon has no gravity",
          "correct": false,
          "explanation": "The Moon certainly has gravity.",
          "misconception": "absolutism error"
        },
        {
          "key": "C",
          "text": "less, so lifting a mass there is easier",
          "correct": true,
          "explanation": "The Moon's weaker field makes lifting easier.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "greater, so lifting is harder",
          "correct": false,
          "explanation": "The Moon's field is weaker than Earth's.",
          "misconception": "direction error"
        }
      ]
    },
    {
      "id": "rn_fw6NFrfWcsgZpNpW::L1::Q4",
      "moduleId": "rn_fw6NFrfWcsgZpNpW::L1",
      "stem": "On the gas giants such as Jupiter, g is…",
      "misconceptionClass": "g variation",
      "options": [
        {
          "key": "A",
          "text": "less than on Earth",
          "correct": false,
          "explanation": "Gas giants pull harder than Earth.",
          "misconception": "direction error"
        },
        {
          "key": "B",
          "text": "exactly 10 N/kg",
          "correct": false,
          "explanation": "10 N/kg is Earth's approximate value.",
          "misconception": "value error"
        },
        {
          "key": "C",
          "text": "irrelevant to weight",
          "correct": false,
          "explanation": "Weight is exactly what g sets.",
          "misconception": "concept error"
        },
        {
          "key": "D",
          "text": "more than on Earth, making lifting harder",
          "correct": true,
          "explanation": "Their greater mass gives stronger fields.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_fw6NFrfWcsgZpNpW::L1::Q5",
      "moduleId": "rn_fw6NFrfWcsgZpNpW::L1",
      "stem": "An object taken from Earth to Jupiter keeps the same…",
      "misconceptionClass": "mass weight contrast",
      "options": [
        {
          "key": "A",
          "text": "mass, though its weight increases",
          "correct": true,
          "explanation": "Mass never changes; weight follows the local field.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "weight, though its mass increases",
          "correct": false,
          "explanation": "Weight changes; mass does not.",
          "misconception": "mass weight swap"
        },
        {
          "key": "C",
          "text": "mass and weight together",
          "correct": false,
          "explanation": "Weight must change when g changes.",
          "misconception": "invariance myth"
        },
        {
          "key": "D",
          "text": "weight, though its mass decreases",
          "correct": false,
          "explanation": "Mass does not decrease on arrival.",
          "misconception": "mass weight swap"
        }
      ]
    },
