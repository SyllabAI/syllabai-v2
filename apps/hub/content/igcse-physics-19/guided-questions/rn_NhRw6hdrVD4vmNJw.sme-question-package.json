        {
          "key": "C",
          "text": "cancel",
          "correct": false,
          "explanation": "Charges on separate objects do not cancel each other.",
          "misconception": "interaction myth"
        },
        {
          "key": "D",
          "text": "discharge",
          "correct": false,
          "explanation": "Discharge needs a conducting path.",
          "misconception": "mechanism myth"
        }
      ]
    },
    {
