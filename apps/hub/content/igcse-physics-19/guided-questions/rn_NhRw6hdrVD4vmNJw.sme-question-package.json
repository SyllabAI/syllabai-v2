        {
          "key": "C",
          "text": "a battery charges a plate",
          "correct": false,
          "explanation": "That is supplied charging, not friction.",
          "misconception": "mechanism slip"
        },
        {
          "key": "D",
          "text": "a spark jumps a gap",
          "correct": false,
          "explanation": "Sparking is a discharge, not a charging method.",
          "misconception": "mechanism slip"
        }
      ]
    },
    {
      "id": "rn_NhRw6hdrVD4vmNJw::L2::Q2",
      "moduleId": "rn_NhRw6hdrVD4vmNJw::L2",
      "stem": "When a polythene rod is rubbed with a cloth, the cloth:",
      "misconceptionClass": "charge reasoning",
      "options": [
        {
          "key": "A",
          "text": "gains electrons and turns negative",
          "correct": false,
          "explanation": "The rod is the gainer here.",
          "misconception": "direction slip"
