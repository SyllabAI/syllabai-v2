    {
      "id": "rn_NhRw6hdrVD4vmNJw::L1::Q1",
      "moduleId": "rn_NhRw6hdrVD4vmNJw::L1",
      "stem": "In a neutral atom:",
      "misconceptionClass": "atomic structure recall",
      "options": [
        {
          "key": "A",
          "text": "electrons equal neutrons",
          "correct": false,
          "explanation": "Neutrons are irrelevant to the balance of charge.",
          "misconception": "particle confusion"
        },
        {
          "key": "B",
          "text": "protons outnumber electrons",
          "correct": false,
          "explanation": "That would leave the atom positive.",
          "misconception": "balance slip"
        },
        {
          "key": "C",
          "text": "electrons equal protons",
          "correct": true,
          "explanation": "Equal opposite charges cancel to zero.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "all charges add to positive",
          "correct": false,
          "explanation": "A neutral atom adds to zero.",
          "misconception": "balance slip"
        }
      ]
    },
    {
