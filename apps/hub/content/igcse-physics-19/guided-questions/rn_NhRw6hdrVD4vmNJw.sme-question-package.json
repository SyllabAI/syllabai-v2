        },
        {
          "key": "B",
          "text": "neutral",
          "correct": false,
          "explanation": "The balance has tipped.",
          "misconception": "balance slip"
        },
        {
          "key": "C",
          "text": "discharged",
          "correct": false,
          "explanation": "Gaining charge is the opposite of discharging.",
          "misconception": "term confusion"
