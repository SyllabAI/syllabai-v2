    {
      "id": "rn_S9XBhFdwtjPR4ZJd::L2::Q8",
      "moduleId": "rn_S9XBhFdwtjPR4ZJd::L2",
      "stem": "Explain why sources with long half-lives shape the whole waste-disposal problem.",
      "misconceptionClass": "waste reasoning",
      "kind": "explain-why",
      "modelAnswer": "Long half-lives keep the waste radioactive and dangerous for very long times, so containers must resist corrosion and sites must stay stable and secure for centuries to keep it out of groundwater.",
      "keywords": [
        "half-lives",
        "radioactive",
        "containers",
        "groundwater"
      ],
      "options": []
    },
    {
      "id": "rn_S9XBhFdwtjPR4ZJd::L2::Q9",
      "moduleId": "rn_S9XBhFdwtjPR4ZJd::L2",
      "stem": "A radiographer’s quarterly badge reading has crept upward across the year. Give two system changes that would reduce the dose.",
      "misconceptionClass": "monitoring application",
      "kind": "application",
      "modelAnswer": "Reduce exposure time per procedure (roster or automation) and increase distance/shielding — for example remote handling or better screens — so the recorded dose per quarter falls.",
      "keywords": [
        "dose",
