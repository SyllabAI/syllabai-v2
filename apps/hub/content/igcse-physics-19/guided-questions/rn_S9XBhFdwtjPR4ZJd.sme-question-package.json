      "moduleId": "rn_S9XBhFdwtjPR4ZJd::L2",
      "stem": "Match each waste type to its storage: alpha, beta, gamma emitters.",
      "misconceptionClass": "waste recall",
      "kind": "recall",
      "modelAnswer": "Alpha waste in plastic or metal canisters; beta waste in metal canisters inside concrete silos; gamma waste in lead-lined, thick concrete silos.",
