          "text": "the law requires visible rust",
          "correct": false,
          "explanation": "Nonsense.",
          "misconception": "nonsense option"
        },
        {
          "key": "B",
          "text": "containers must stay intact for very long periods in hostile conditions",
          "correct": true,
          "explanation": "Integrity over centuries is the design brief.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "rust increases the activity",
          "correct": false,
          "explanation": "Chemistry does not change nuclear activity.",
          "misconception": "activity myth"
        },
        {
          "key": "D",
          "text": "rust makes waste less dangerous",
          "correct": false,
          "explanation": "Corrosion threatens containment.",
