        }
      ]
    },
    {
      "id": "rn_S9XBhFdwtjPR4ZJd::L2::Q6",
      "moduleId": "rn_S9XBhFdwtjPR4ZJd::L2",
      "stem": "List four precautions a student should take when using a radioactive source.",
      "misconceptionClass": "safety recall",
      "kind": "recall",
      "modelAnswer": "Store the source in its lead-lined box until the moment it is needed, handle it with tongs, keep maximum distance, and minimise the time it is out (then wash hands and log the usage).",
      "keywords": [
        "lead",
