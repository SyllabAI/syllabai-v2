    {
      "id": "rn_ws8NtMW3QwCs73Gh::L2::Q7",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L2",
      "stem": "Give two evaluation points for this experiment.",
      "misconceptionClass": "evaluation recall",
      "kind": "recall",
