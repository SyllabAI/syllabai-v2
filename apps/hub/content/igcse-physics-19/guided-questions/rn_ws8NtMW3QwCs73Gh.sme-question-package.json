  "questions": [
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L1::Q1",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L1",
      "stem": "The independent variable is:",
      "misconceptionClass": "variables recall",
      "options": [
        {
          "key": "A",
          "text": "the rubbing time",
          "correct": false,
          "explanation": "Rubbing time is controlled, not varied.",
          "misconception": "variable swap"
        },
        {
          "key": "B",
          "text": "the cloth type",
          "correct": false,
          "explanation": "The cloth is kept the same on purpose.",
          "misconception": "variable swap"
        },
        {
          "key": "C",
          "text": "the rod material",
          "correct": true,
          "explanation": "Different rod materials are what the experiment varies.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "the deflection seen",
          "correct": false,
          "explanation": "Deflection is an observation, not the set variable.",
          "misconception": "variable swap"
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L1::Q2",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L1",
      "stem": "The dependent variable is:",
      "misconceptionClass": "variables recall",
      "options": [
        {
          "key": "A",
          "text": "the charge on the rod",
          "correct": true,
          "explanation": "The charge produced by rubbing is what the experiment measures.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "the room temperature",
          "correct": false,
          "explanation": "Temperature is neither varied nor measured here.",
          "misconception": "irrelevant quantity"
        },
        {
          "key": "C",
          "text": "the rod length",
          "correct": false,
          "explanation": "Rod length is controlled.",
          "misconception": "variable swap"
        },
        {
          "key": "D",
          "text": "the string tension",
          "correct": false,
          "explanation": "String tension is not the measured quantity.",
          "misconception": "irrelevant quantity"
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L1::Q3",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L1",
      "stem": "Why must the rods never touch during the test?",
      "misconceptionClass": "method reasoning",
      "options": [
        {
          "key": "A",
          "text": "the rods would melt",
          "correct": false,
          "explanation": "Nothing in the procedure heats the rods.",
          "misconception": "invented effect"
        },
        {
          "key": "B",
          "text": "the string would snap",
          "correct": false,
          "explanation": "The string never comes under such a load.",
          "misconception": "invented effect"
        },
        {
          "key": "C",
          "text": "the charge would double",
          "correct": false,
          "explanation": "Contact does not create charge.",
          "misconception": "conservation myth"
        },
        {
          "key": "D",
          "text": "contact would discharge them and the forces would vanish",
          "correct": true,
          "explanation": "Touching lets the charge flow away, removing the observed forces.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L1::Q4",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L1",
      "stem": "The polythene rod is suspended so that it can:",
      "misconceptionClass": "apparatus recall",
      "options": [
        {
          "key": "A",
          "text": "heat up evenly",
          "correct": false,
          "explanation": "Heating plays no role.",
          "misconception": "irrelevant effect"
        },
        {
          "key": "B",
          "text": "swing freely when a force acts",
          "correct": true,
          "explanation": "The cradle and nylon string let the rod respond to tiny electrostatic forces.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "touch the cradle",
          "correct": false,
          "explanation": "Contact with the cradle would discharge it.",
          "misconception": "method slip"
        },
        {
          "key": "D",
          "text": "rub against the stand",
          "correct": false,
          "explanation": "The rod hangs clear of the stand.",
          "misconception": "method slip"
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L1::Q5",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L1",
      "stem": "Which control keeps the charge transferred comparable between trials?",
      "misconceptionClass": "variables reasoning",
      "options": [
        {
          "key": "A",
          "text": "rubbing for the same time with the same cloth",
          "correct": true,
          "explanation": "Both time and cloth are held fixed so the trials compare fairly.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "using rods of different lengths",
          "correct": false,
          "explanation": "Length is a control — it must not vary.",
          "misconception": "control slip"
        },
        {
          "key": "C",
          "text": "changing the cloth each trial",
          "correct": false,
          "explanation": "The cloth stays the same.",
          "misconception": "control slip"
        },
        {
          "key": "D",
          "text": "rubbing faster each time",
          "correct": false,
          "explanation": "Varying the rubbing undermines the comparison.",
          "misconception": "control slip"
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L1::Q6",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L1",
      "stem": "List the equipment used to suspend the test rod.",
      "misconceptionClass": "apparatus recall",
