    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L2::Q1",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L2",
      "stem": "A polythene rod rubbed with a cloth becomes negative because:",
      "misconceptionClass": "charge reasoning",
      "options": [
        {
          "key": "A",
          "text": "protons transfer onto it from the cloth",
          "correct": false,
          "explanation": "Protons never leave nuclei.",
          "misconception": "particle confusion"
        },
        {
          "key": "B",
          "text": "electrons transfer onto it from the cloth",
          "correct": true,
          "explanation": "The polythene gains the cloth's electrons and so turns negative.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "it loses electrons to the cloth",
          "correct": false,
          "explanation": "That would leave it positive — the acetate behaviour.",
          "misconception": "direction slip"
        },
        {
          "key": "D",
          "text": "the cloth donates positive charge",
          "correct": false,
          "explanation": "Only electrons move; positive charge never travels.",
          "misconception": "particle confusion"
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L2::Q2",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L2",
      "stem": "An acetate rod rubbed with a cloth becomes positive because it:",
      "misconceptionClass": "charge reasoning",
      "options": [
        {
          "key": "A",
          "text": "gains electrons",
          "correct": false,
          "explanation": "Gaining electrons is the negative case.",
          "misconception": "direction slip"
        },
        {
          "key": "B",
          "text": "gains protons",
          "correct": false,
          "explanation": "Protons stay fixed.",
          "misconception": "particle confusion"
        },
        {
          "key": "C",
          "text": "loses electrons to the cloth",
          "correct": true,
          "explanation": "Losing negative charge leaves the acetate positive.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "keeps every electron",
          "correct": false,
          "explanation": "If it kept them all it would stay neutral.",
          "misconception": "conservation myth"
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L2::Q3",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L2",
      "stem": "The hanging polythene rod rotates away from a test rod. The test rod is:",
      "misconceptionClass": "analysis reasoning",
      "options": [
        {
          "key": "A",
          "text": "uncharged",
          "correct": false,
          "explanation": "An uncharged rod would not repel.",
          "misconception": "response slip"
        },
        {
          "key": "B",
          "text": "charged positive",
          "correct": false,
          "explanation": "Opposite signs attract.",
          "misconception": "response slip"
        },
        {
          "key": "C",
          "text": "earthed",
          "correct": false,
          "explanation": "An earthed rod would not push the hanging one away.",
          "misconception": "response slip"
        },
        {
          "key": "D",
          "text": "charged the same, negative",
          "correct": true,
          "explanation": "Like charges repel, so the test rod is also negative.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L2::Q4",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L2",
      "stem": "Attraction to the hanging polythene rod shows the test rod's charge is:",
      "misconceptionClass": "analysis reasoning",
      "options": [
        {
          "key": "A",
          "text": "opposite to the rod's",
          "correct": true,
          "explanation": "Opposite charges attract.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "identical to the rod's",
          "correct": false,
          "explanation": "Like charges repel.",
          "misconception": "response slip"
        },
        {
          "key": "C",
          "text": "zero",
          "correct": false,
          "explanation": "An uncharged rod produces no such direct electrostatic repulsion-or-attraction pair in this test.",
          "misconception": "overcomplication"
        },
        {
          "key": "D",
          "text": "doubled",
          "correct": false,
          "explanation": "Charge is not created by proximity.",
          "misconception": "nonsense option"
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L2::Q5",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L2",
      "stem": "The numerical improvement swaps the dependent variable for:",
      "misconceptionClass": "evaluation recall",
      "options": [
        {
          "key": "A",
          "text": "the rod's temperature rise",
          "correct": false,
          "explanation": "Temperature is irrelevant here.",
          "misconception": "irrelevant quantity"
        },
        {
          "key": "B",
          "text": "the number of paper circles picked up",
          "correct": true,
          "explanation": "Counting circles turns the observation into data.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "the string's angle only",
          "correct": false,
          "explanation": "Angle alone is not the recorded upgrade described.",
          "misconception": "detail slip"
        },
        {
          "key": "D",
          "text": "the cloth's mass loss",
          "correct": false,
          "explanation": "Mass loss is not measurable at this scale.",
          "misconception": "invented method"
        }
      ]
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L2::Q6",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L2",
      "stem": "State what happens to electrons when two insulators are rubbed together.",
      "misconceptionClass": "analysis recall",
      "kind": "recall",
      "modelAnswer": "Electrons transfer from one insulator onto the other, leaving one negative and the other positive.",
