    {
      "id": "rn_ws8NtMW3QwCs73Gh::L2::Q8",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L2",
      "stem": "Explain why an object that loses electrons becomes positively charged.",
      "misconceptionClass": "reasoning",
      "kind": "explain-why",
      "modelAnswer": "A neutral object scores zero; removing an electron subtracts a negative charge, and 0 − (−1) = +1, so the remainder is positive.",
