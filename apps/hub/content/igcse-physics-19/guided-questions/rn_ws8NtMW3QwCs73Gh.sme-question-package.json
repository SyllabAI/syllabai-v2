    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L1::Q8",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L1",
      "stem": "Explain why the ends of the rods must not be handled after rubbing.",
      "misconceptionClass": "method reasoning",
      "kind": "explain-why",
      "modelAnswer": "Fingers would earth the rubbed ends, draining the charge just gathered and leaving no force to observe.",
      "keywords": [
        "ends",
        "charge",
        "draining",
        "force",
        "observe"
      ],
      "options": []
    },
    {
      "id": "rn_ws8NtMW3QwCs73Gh::L1::Q9",
      "moduleId": "rn_ws8NtMW3QwCs73Gh::L1",
      "stem": "A student rubs the acrylic rod for twice as long as the polythene one. Identify the variable ignored and the effect on the comparison.",
      "misconceptionClass": "method evaluation",
      "kind": "application",
      "modelAnswer": "The controlled rubbing time was ignored; the extra charge on the acrylic would exaggerate its deflection and bias the comparison.",
      "keywords": [
        "rubbing",
        "time",
        "charge",
        "deflection",
        "bias"
      ],
