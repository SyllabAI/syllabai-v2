      "options": [
        {
          "key": "A",
          "text": "constant one-way flow",
          "correct": false,
          "explanation": "That is direct current.",
          "misconception": "category swap"
        },
        {
          "key": "B",
          "text": "zero frequency",
          "correct": false,
          "explanation": "A.c. has a frequency by definition.",
          "misconception": "contradiction"
        },
        {
          "key": "C",
          "text": "continuous reversal of direction",
          "correct": true,
          "explanation": "The current keeps changing direction, back and forth.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "fixed polarity",
          "correct": false,
          "explanation": "The polarity swaps — that is the point.",
          "misconception": "contradiction"
        }
      ]
    },
    {
