  "questions": [
    {
      "id": "rn_NgxJhPpm5Zs7kFSz::L1::Q1",
      "moduleId": "rn_NgxJhPpm5Zs7kFSz::L1",
      "stem": "In a d.c. circuit the charge flows:",
      "misconceptionClass": "definition recall",
      "options": [
        {
          "key": "A",
          "text": "back and forth rapidly",
          "correct": false,
          "explanation": "That is alternating current.",
          "misconception": "category swap"
        },
        {
          "key": "B",
          "text": "one way only, positive to negative",
          "correct": true,
          "explanation": "Direct current keeps a single direction.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "from negative to positive only",
          "correct": false,
          "explanation": "The conventional direction runs positive to negative.",
          "misconception": "direction slip"
        },
        {
          "key": "D",
          "text": "in neither direction",
          "correct": false,
          "explanation": "A working circuit carries current.",
          "misconception": "nonsense option"
        }
      ]
    },
    {
      "id": "rn_NgxJhPpm5Zs7kFSz::L1::Q2",
      "moduleId": "rn_NgxJhPpm5Zs7kFSz::L1",
      "stem": "Which supply has fixed terminals?",
      "misconceptionClass": "property recall",
      "options": [
        {
          "key": "A",
          "text": "the UK mains",
          "correct": false,
          "explanation": "Mains polarity alternates.",
          "misconception": "category swap"
        },
        {
          "key": "B",
          "text": "a generator",
          "correct": false,
          "explanation": "Generators produce the alternating mains.",
          "misconception": "category swap"
        },
        {
          "key": "C",
          "text": "an alternator",
          "correct": false,
          "explanation": "An alternator is an a.c. source by design.",
          "misconception": "category swap"
        },
        {
          "key": "D",
          "text": "a battery",
          "correct": true,
          "explanation": "A battery's positive and negative terminals stay fixed.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_NgxJhPpm5Zs7kFSz::L1::Q3",
      "moduleId": "rn_NgxJhPpm5Zs7kFSz::L1",
      "stem": "Cells and batteries provide:",
      "misconceptionClass": "source recall",
      "options": [
        {
          "key": "A",
          "text": "direct current",
          "correct": true,
          "explanation": "Cells and batteries are the d.c. sources.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "alternating current",
          "correct": false,
          "explanation": "That comes from generators and the mains.",
          "misconception": "category swap"
        },
        {
          "key": "C",
          "text": "static charge only",
          "correct": false,
          "explanation": "Batteries drive a continuous flow, not static build-up.",
          "misconception": "category swap"
        },
        {
          "key": "D",
          "text": "no current",
          "correct": false,
          "explanation": "A battery in a closed circuit drives current.",
          "misconception": "nonsense option"
        }
      ]
    },
    {
      "id": "rn_NgxJhPpm5Zs7kFSz::L1::Q4",
      "moduleId": "rn_NgxJhPpm5Zs7kFSz::L1",
      "stem": "The current in a d.c. circuit flows:",
      "misconceptionClass": "reasoning recall",
      "options": [
        {
          "key": "A",
          "text": "in alternating directions",
          "correct": false,
          "explanation": "The polarity never swaps, so the direction never swaps.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "nowhere",
          "correct": false,
          "explanation": "In a closed circuit the current flows.",
          "misconception": "nonsense option"
        },
        {
          "key": "C",
          "text": "in one direction around the circuit",
          "correct": true,
          "explanation": "Fixed polarity means one-way flow.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "only while the switch is open",
          "correct": false,
          "explanation": "An open switch stops the flow.",
          "misconception": "switch slip"
        }
      ]
    },
    {
      "id": "rn_NgxJhPpm5Zs7kFSz::L1::Q5",
      "moduleId": "rn_NgxJhPpm5Zs7kFSz::L1",
      "stem": "On an oscilloscope, a direct current trace appears as:",
      "misconceptionClass": "graph recall",
      "options": [
        {
          "key": "A",
          "text": "a sine wave",
          "correct": false,
          "explanation": "That is the alternating trace.",
          "misconception": "trace swap"
        },
        {
          "key": "B",
          "text": "a flat line at fixed height",
          "correct": true,
          "explanation": "A steady one-way current sits at a constant level.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "a sawtooth",
          "correct": false,
          "explanation": "Neither supply gives a sawtooth here.",
          "misconception": "trace invention"
        },
        {
          "key": "D",
          "text": "a random scatter",
          "correct": false,
          "explanation": "The trace is steady, not noisy.",
          "misconception": "trace invention"
        }
      ]
    },
    {
      "id": "rn_NgxJhPpm5Zs7kFSz::L1::Q6",
      "moduleId": "rn_NgxJhPpm5Zs7kFSz::L1",
      "stem": "Define direct current.",
      "misconceptionClass": "definition recall",
      "kind": "recall",
      "modelAnswer": "A steady current that keeps flowing the same way around the circuit, from positive to negative.",
      "keywords": [
        "steady",
