          "correct": false,
          "explanation": "That describes d.c.",
          "misconception": "category swap"
        },
        {
          "key": "B",
          "text": "identical and constantly swapping polarity",
          "correct": true,
          "explanation": "Each terminal takes both roles in turn.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "both always negative",
          "correct": false,
          "explanation": "They alternate between both signs.",
          "misconception": "contradiction"
        },
        {
          "key": "D",
          "text": "insulated from the circuit",
          "correct": false,
          "explanation": "They connect to the circuit by definition.",
          "misconception": "nonsense option"
        }
