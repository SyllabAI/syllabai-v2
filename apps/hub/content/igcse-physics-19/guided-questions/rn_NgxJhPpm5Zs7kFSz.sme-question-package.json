    {
      "id": "rn_NgxJhPpm5Zs7kFSz::L1::Q8",
      "moduleId": "rn_NgxJhPpm5Zs7kFSz::L1",
      "stem": "Explain why a battery cannot power a device that needs the current to reverse.",
      "misconceptionClass": "reasoning",
      "kind": "explain-why",
      "modelAnswer": "A battery's terminals are fixed, so its push stays one way round the circuit; reversing the current would need the polarity to swap, which only an alternating supply does.",
      "keywords": [
        "battery",
        "terminals",
        "current",
        "reverse",
        "polarity"
      ],
      "options": []
    },
    {
      "id": "rn_NgxJhPpm5Zs7kFSz::L1::Q9",
      "moduleId": "rn_NgxJhPpm5Zs7kFSz::L1",
      "stem": "A torch runs from two cells in a holder. State the kind of supply and the direction of the current through the lamp.",
      "misconceptionClass": "application",
      "kind": "application",
      "modelAnswer": "Direct current, flowing steadily from the positive terminal of the holder, through the lamp, to the negative terminal.",
      "keywords": [
        "direct",
        "current",
        "positive",
        "negative",
        "terminal"
