  "questions": [
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L1::Q1",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L1",
      "stem": "The wave speed equation in symbols is:",
      "misconceptionClass": "equation recall",
      "options": [
        {
          "key": "A",
          "text": "v = f / lambda",
          "correct": false,
          "explanation": "Dividing would give the wrong dimensions; the law multiplies.",
          "misconception": "operation slip"
        },
        {
          "key": "B",
          "text": "v = f x lambda",
          "correct": true,
          "explanation": "Wave speed equals frequency multiplied by wavelength.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "v = lambda / f",
          "correct": false,
          "explanation": "That would divide a length by a count per second.",
          "misconception": "operation slip"
        },
        {
          "key": "D",
          "text": "f = v x lambda",
          "correct": false,
          "explanation": "Rearranged wrongly: frequency is v divided by lambda.",
          "misconception": "rearrangement slip"
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L1::Q2",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L1",
      "stem": "In v = f x lambda, the quantity v stands for:",
      "misconceptionClass": "symbol recall",
      "options": [
        {
          "key": "A",
          "text": "volume in cubic metres",
          "correct": false,
          "explanation": "Volume has no role in the wave equation.",
          "misconception": "symbol confusion"
        },
        {
          "key": "B",
          "text": "voltage in volts",
          "correct": false,
          "explanation": "Voltage belongs to electricity, not this law.",
          "misconception": "subject confusion"
        },
        {
          "key": "C",
          "text": "wave speed in metres per second",
          "correct": true,
          "explanation": "v carries the speed in m/s.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "frequency in hertz",
          "correct": false,
          "explanation": "Frequency is the f term.",
          "misconception": "symbol swap"
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L1::Q3",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L1",
      "stem": "A wave has frequency 2 Hz and wavelength 0.5 m. Its speed is:",
      "misconceptionClass": "equation application",
      "options": [
        {
          "key": "A",
          "text": "0.25 m/s",
          "correct": false,
          "explanation": "That comes from multiplying 0.5 by 0.5; the frequency is 2.",
          "misconception": "arithmetic slip"
        },
        {
          "key": "B",
          "text": "2.5 m/s",
          "correct": false,
          "explanation": "Adding instead of multiplying is not the law.",
          "misconception": "operation slip"
        },
        {
          "key": "C",
          "text": "4 m/s",
          "correct": false,
          "explanation": "That divides by the wavelength instead of multiplying.",
          "misconception": "operation slip"
        },
        {
          "key": "D",
          "text": "1 m/s",
          "correct": true,
          "explanation": "v = 2 x 0.5 = 1 m/s.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L1::Q4",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L1",
      "stem": "Rearranging v = f x lambda to find the wavelength gives:",
      "misconceptionClass": "rearrangement",
      "options": [
        {
          "key": "A",
          "text": "lambda = v / f",
          "correct": true,
          "explanation": "Dividing speed by frequency leaves the wavelength.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "lambda = f / v",
          "correct": false,
          "explanation": "That inverts the rearrangement.",
          "misconception": "rearrangement slip"
        },
        {
          "key": "C",
          "text": "lambda = v x f",
          "correct": false,
          "explanation": "Multiplying both quantities gives speed squared units.",
          "misconception": "rearrangement slip"
        },
        {
          "key": "D",
          "text": "lambda = v + f",
          "correct": false,
          "explanation": "The law multiplies, so the inverse divides.",
          "misconception": "operation slip"
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L1::Q5",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L1",
      "stem": "A sound wave has speed 300 m/s and frequency 500 Hz. Its wavelength is:",
      "misconceptionClass": "equation application",
      "options": [
        {
          "key": "A",
          "text": "150000 m",
          "correct": false,
          "explanation": "That multiplies instead of dividing; a wavelength of 150 km is not physical here.",
          "misconception": "operation slip"
        },
        {
          "key": "B",
          "text": "800 m",
          "correct": false,
          "explanation": "Adding speed and frequency has no meaning in this law.",
          "misconception": "operation slip"
        },
        {
          "key": "C",
          "text": "0.6 m",
          "correct": true,
          "explanation": "lambda = 300 / 500 = 0.6 m.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "1.7 m",
          "correct": false,
          "explanation": "That divides frequency by speed, the inverted ratio.",
          "misconception": "rearrangement slip"
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L1::Q6",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L1",
      "stem": "State the wave speed equation in words and in symbols.",
      "misconceptionClass": "definition recall",
      "kind": "recall",
      "modelAnswer": "Wave speed = frequency x wavelength, written v = f x lambda.",
      "keywords": [
        "wave speed",
        "frequency",
        "wavelength",
        "written",
        "lambda"
      ],
      "options": []
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L1::Q7",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L1",
      "stem": "State the units of v, f and lambda in the wave speed equation.",
      "misconceptionClass": "definition recall",
      "kind": "recall",
      "modelAnswer": "v is in metres per second, f in hertz and lambda in metres.",
      "keywords": [
        "metres per second",
        "hertz",
        "metres"
      ],
      "options": []
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L1::Q8",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L1",
      "stem": "Explain how the formula triangle is used to find frequency from speed and wavelength.",
      "misconceptionClass": "evaluation reasoning",
      "kind": "explain-why",
      "modelAnswer": "Covering f in the triangle leaves v over lambda, so frequency is the wave speed divided by the wavelength, which is the rearrangement of v = f x lambda for f.",
      "keywords": [
        "cover",
        "speed",
        "divided",
        "wavelength",
        "rearrangement"
      ],
      "options": []
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L1::Q9",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L1",
      "stem": "A water ripple travels at 0.4 m/s with wavelength 0.1 m. Calculate its frequency, showing the equation you use.",
      "misconceptionClass": "application transfer",
      "kind": "application",
      "modelAnswer": "f = v / lambda = 0.4 / 0.1 = 4 Hz, using the wave speed equation rearranged for frequency.",
      "keywords": [
        "frequency",
        "0.4",
        "0.1",
        "4",
        "hertz"
      ],
      "options": []
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L2::Q1",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L2",
      "stem": "The equation linking frequency and time period is:",
      "misconceptionClass": "equation recall",
      "options": [
        {
          "key": "A",
          "text": "f = T",
          "correct": false,
          "explanation": "They are reciprocal, not equal.",
          "misconception": "reciprocal confusion"
        },
        {
          "key": "B",
          "text": "f = 1 / T",
          "correct": true,
          "explanation": "Frequency is the reciprocal of the period.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "f = 1 / T squared",
          "correct": false,
          "explanation": "No squaring appears in the relationship.",
          "misconception": "operation invention"
        },
        {
          "key": "D",
          "text": "f = T / 1",
          "correct": false,
          "explanation": "That just restates the period as frequency.",
          "misconception": "reciprocal confusion"
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L2::Q2",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L2",
      "stem": "A wave has time period 0.5 s. Its frequency is:",
      "misconceptionClass": "reciprocal application",
      "options": [
        {
          "key": "A",
          "text": "0.5 Hz",
          "correct": false,
          "explanation": "That restates the period as a frequency.",
          "misconception": "reciprocal confusion"
        },
        {
          "key": "B",
          "text": "5 Hz",
          "correct": false,
          "explanation": "No factor of ten is involved.",
          "misconception": "arithmetic slip"
        },
        {
          "key": "C",
          "text": "1.5 Hz",
          "correct": false,
          "explanation": "Nothing adds one here.",
          "misconception": "arithmetic invention"
        },
        {
          "key": "D",
          "text": "2 Hz",
          "correct": true,
          "explanation": "f = 1 / 0.5 = 2 Hz.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L2::Q3",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L2",
      "stem": "A wave repeats every 0.02 s. Its frequency is:",
      "misconceptionClass": "reciprocal application",
      "options": [
        {
          "key": "A",
          "text": "50 Hz",
          "correct": true,
          "explanation": "f = 1 / 0.02 = 50 Hz.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "0.02 Hz",
          "correct": false,
          "explanation": "That is the period quoted as a frequency.",
          "misconception": "reciprocal confusion"
        },
        {
          "key": "C",
          "text": "20 Hz",
          "correct": false,
          "explanation": "That drops a zero in the division.",
          "misconception": "arithmetic slip"
        },
        {
          "key": "D",
          "text": "200 Hz",
          "correct": false,
          "explanation": "That inserts an extra factor of ten.",
          "misconception": "arithmetic slip"
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L2::Q4",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L2",
      "stem": "Rearranging f = 1 / T for the period gives:",
      "misconceptionClass": "rearrangement",
      "options": [
        {
          "key": "A",
          "text": "T = f",
          "correct": false,
          "explanation": "Period and frequency are not equal.",
          "misconception": "reciprocal confusion"
        },
        {
          "key": "B",
          "text": "T = 1 - f",
          "correct": false,
          "explanation": "The relationship is division, not subtraction.",
          "misconception": "operation slip"
        },
        {
          "key": "C",
          "text": "T = 1 / f",
          "correct": true,
          "explanation": "The reciprocal swaps sides symmetrically.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "T = f / 1",
          "correct": false,
          "explanation": "That restates frequency as the period.",
          "misconception": "reciprocal confusion"
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L2::Q5",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L2",
      "stem": "A signal has frequency 200 Hz. Its time period is:",
      "misconceptionClass": "reciprocal application",
      "options": [
        {
          "key": "A",
          "text": "200 s",
          "correct": false,
          "explanation": "That restates the frequency as a period in seconds.",
          "misconception": "reciprocal confusion"
        },
        {
          "key": "B",
          "text": "0.005 s",
          "correct": true,
          "explanation": "T = 1 / 200 = 0.005 s.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "0.2 s",
          "correct": false,
          "explanation": "That would follow from a frequency of 5 Hz.",
          "misconception": "arithmetic slip"
        },
        {
          "key": "D",
          "text": "20 s",
          "correct": false,
          "explanation": "No scaling by ten applies.",
          "misconception": "arithmetic slip"
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L2::Q6",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L2",
      "stem": "State in words how frequency and the time period are related.",
      "misconceptionClass": "definition recall",
