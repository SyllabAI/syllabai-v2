    {
      "id": "rn_hkV9ncw6zTQqrbN5::L2::Q8",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L2",
      "stem": "Explain why a wave with a shorter time period has a higher frequency.",
      "misconceptionClass": "evaluation reasoning",
      "kind": "explain-why",
      "modelAnswer": "Frequency counts the waves arriving each second by dividing one second by the time each wave takes, so shrinking the per-wave time raises the per-second count.",
