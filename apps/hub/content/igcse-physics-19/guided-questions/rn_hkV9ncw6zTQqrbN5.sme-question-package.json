          "text": "0.2 Hz",
          "correct": false,
          "explanation": "That divides instead of multiplying.",
          "misconception": "conversion inversion"
        }
      ]
    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L3::Q3",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L3",
      "stem": "A radio station broadcasts at 200 kHz with wavelength 1500 m. The wave speed is:",
      "misconceptionClass": "chained application",
      "options": [
        {
          "key": "A",
          "text": "300000 m/s",
          "correct": false,
          "explanation": "That drops two zeros from the product.",
          "misconception": "arithmetic slip"
        },
        {
          "key": "B",
          "text": "0.13 m/s",
