    {
      "id": "rn_hkV9ncw6zTQqrbN5::L3::Q1",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L3",
      "stem": "The wave speed equation can be applied to:",
      "misconceptionClass": "scope law",
      "options": [
        {
