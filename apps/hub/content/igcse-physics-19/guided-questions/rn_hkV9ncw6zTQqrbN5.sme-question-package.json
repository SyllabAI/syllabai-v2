    },
    {
      "id": "rn_hkV9ncw6zTQqrbN5::L2::Q9",
      "moduleId": "rn_hkV9ncw6zTQqrbN5::L2",
      "stem": "A vibrating toy completes 200 vibrations per second. Calculate the time period of one vibration.",
