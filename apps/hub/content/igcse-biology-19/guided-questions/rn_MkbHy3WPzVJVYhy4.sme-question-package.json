    {
      "id": "rn_MkbHy3WPzVJVYhy4::L2::Q5",
      "moduleId": "rn_MkbHy3WPzVJVYhy4::L2",
      "stem": "Which pairing of limitation and consequence is correct?",
      "misconceptionClass": "limitation consequence",
      "options": [
        {
          "key": "A",
          "text": "Colorimeter — it removes the need for amylase",
          "correct": false,
          "explanation": "The enzyme is still required.",
          "misconception": "function invented"
        },
        {
          "key": "B",
          "text": "Temperature drift — the true temperature behind a rate is uncertain",
          "correct": true,
          "explanation": "Drift confuses the attribution of the measured rate.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Colour judgement — the enzyme digests faster",
          "correct": false,
          "explanation": "Judgement error adds noise, it does not speed digestion.",
          "misconception": "effect invented"
        },
        {
          "key": "D",
          "text": "Water baths — they cause denaturation",
          "correct": false,
          "explanation": "Baths prevent drift; they do not denature.",
          "misconception": "effect invented"
        }
      ]
    },
