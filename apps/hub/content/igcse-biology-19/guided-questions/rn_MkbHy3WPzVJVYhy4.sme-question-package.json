    {
      "id": "rn_MkbHy3WPzVJVYhy4::L2::Q8",
      "moduleId": "rn_MkbHy3WPzVJVYhy4::L2",
      "stem": "Explain why the well-count method can miss the exact moment digestion finishes.",
      "misconceptionClass": "resolution reasoning",
      "kind": "explain-why",
      "modelAnswer": "Droplets are transferred only once per minute, so the endpoint is only known to fall somewhere inside a one-minute window between the last blue-black well and the first unchanged one; finer sampling intervals would narrow that window.",
      "keywords": [
        "droplet",
        "minute",
        "endpoint",
        "transferred"
      ],
      "options": []
    },
    {
      "id": "rn_MkbHy3WPzVJVYhy4::L2::Q9",
      "moduleId": "rn_MkbHy3WPzVJVYhy4::L2",
      "stem": "A class runs the practical with baths at 30, 40 and 50 degrees and gets mean well counts of 9, 4 and 8. Which temperature sits nearest the optimum, and why does 50 still finish faster than 30?",
      "misconceptionClass": "data application",
      "kind": "application",
      "modelAnswer": "40 degrees is nearest the optimum because its count of 4 is the shortest; 50 beats 30 because at 50 the enzyme still holds enough shape to work faster than the collision-starved 30-degree run, even though denaturation has begun eating into its rate.",
      "keywords": [
        "optimum",
        "collisions",
        "denaturation",
        "shortest"
      ],
      "options": []
    }
  ]
