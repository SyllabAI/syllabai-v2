      "stem": "What lies immediately inside the cell membrane?",
      "misconceptionClass": "inside the membrane",
      "options": [
        {
          "key": "A",
          "text": "The cytoplasm",
          "correct": true,
          "explanation": "Cytoplasm fills the interior.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The cell wall",
          "correct": false,
          "explanation": "Walls sit OUTSIDE the membrane in plants.",
          "misconception": "position inverted"
        },
        {
          "key": "C",
          "text": "The vacuole only",
          "correct": false,
          "explanation": "The vacuole sits within the cytoplasm.",
          "misconception": "containment inverted"
