  "questions": [
    {
      "id": "rn_crVHckMJcJw7d56s::L1::Q1",
      "moduleId": "rn_crVHckMJcJw7d56s::L1",
      "stem": "Which stimulus does the eye detect?",
      "misconceptionClass": "stimulus identification",
      "options": [
        {
          "key": "A",
          "text": "Light",
          "correct": true,
          "explanation": "The eye's receptor cells are sensitive to light.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Sound",
          "correct": false,
          "explanation": "Sound belongs to the ears.",
          "misconception": "sense swapped"
        },
        {
          "key": "C",
          "text": "Chemicals in food",
          "correct": false,
          "explanation": "That is taste's stimulus.",
          "misconception": "sense swapped"
        },
        {
          "key": "D",
          "text": "Pressure on the skin",
          "correct": false,
          "explanation": "That is touch's stimulus.",
          "misconception": "sense swapped"
        }
      ]
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L1::Q2",
      "moduleId": "rn_crVHckMJcJw7d56s::L1",
      "stem": "Where are the eye's light-sensitive receptor cells located?",
      "misconceptionClass": "receptor location",
      "options": [
        {
          "key": "A",
          "text": "In the lens",
          "correct": false,
          "explanation": "The lens focuses; it is transparent, not sensitive.",
          "misconception": "structure swapped"
        },
        {
          "key": "B",
          "text": "In the retina",
          "correct": true,
          "explanation": "The retina contains the receptor cells sensitive to light.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "In the cornea",
          "correct": false,
          "explanation": "The cornea refracts light; it has no receptors.",
          "misconception": "structure swapped"
        },
        {
          "key": "D",
          "text": "In the sclera",
          "correct": false,
          "explanation": "The sclera is the protective outer wall.",
          "misconception": "structure swapped"
        }
      ]
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L1::Q3",
      "moduleId": "rn_crVHckMJcJw7d56s::L1",
      "stem": "Which nerve carries impulses away from the eye?",
      "misconceptionClass": "pathway recall",
      "options": [
        {
          "key": "A",
          "text": "The motor nerve to the jaw",
          "correct": false,
          "explanation": "Motor nerves serve muscles, not the retina.",
          "misconception": "nerve invented"
        },
        {
          "key": "B",
          "text": "No nerve leaves the eye",
          "correct": false,
          "explanation": "Impulses must travel to the brain somehow.",
          "misconception": "pathway denied"
        },
        {
          "key": "C",
          "text": "The optic nerve",
          "correct": true,
          "explanation": "The optic nerve links eye and brain.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "The auditory nerve",
          "correct": false,
          "explanation": "That serves hearing.",
          "misconception": "nerve swapped"
        }
      ]
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L1::Q4",
      "moduleId": "rn_crVHckMJcJw7d56s::L1",
      "stem": "What makes the eye a receptor organ?",
      "misconceptionClass": "receptor definition",
      "options": [
        {
          "key": "A",
          "text": "It is white and round",
          "correct": false,
          "explanation": "Shape is irrelevant to receptor function.",
          "misconception": "surface feature confused"
        },
        {
          "key": "B",
          "text": "It produces hormones",
          "correct": false,
          "explanation": "The eye is not an endocrine gland.",
          "misconception": "system confused"
        },
        {
          "key": "C",
          "text": "It stores light for later use",
          "correct": false,
          "explanation": "Light is detected, not stored.",
          "misconception": "claim invented"
        },
        {
          "key": "D",
          "text": "It contains receptor cells that convert light into electrical impulses",
          "correct": true,
          "explanation": "Receptor organs detect their stimulus and start impulses.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L1::Q5",
      "moduleId": "rn_crVHckMJcJw7d56s::L1",
      "stem": "Which pairing of structure and role is correct?",
      "misconceptionClass": "structure role pairing",
      "options": [
        {
          "key": "A",
          "text": "Optic nerve — carries impulses between eye and brain",
          "correct": true,
          "explanation": "That is exactly its listed function.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Conjunctiva — focuses light",
          "correct": false,
          "explanation": "The conjunctiva lubricates and protects.",
          "misconception": "role misassigned"
        },
        {
          "key": "C",
          "text": "Cornea — detects colour",
          "correct": false,
          "explanation": "The cornea refracts; detection is retinal.",
          "misconception": "role misassigned"
        },
        {
          "key": "D",
          "text": "Sclera — transmits impulses",
          "correct": false,
          "explanation": "The sclera is the outer wall; impulses go via the optic nerve.",
          "misconception": "role misassigned"
        }
      ]
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L1::Q6",
      "moduleId": "rn_crVHckMJcJw7d56s::L1",
      "stem": "State the layer containing the eye's light-sensitive receptor cells.",
      "misconceptionClass": "layer recall",
      "kind": "recall",
      "modelAnswer": "The retina, at the back of the eye.",
      "keywords": [
        "retina",
        "receptor cells",
        "back"
      ],
      "options": []
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L1::Q7",
      "moduleId": "rn_crVHckMJcJw7d56s::L1",
      "stem": "Name the nerve linking the eye to the brain.",
      "misconceptionClass": "nerve recall",
      "kind": "recall",
      "modelAnswer": "The optic nerve.",
      "keywords": [
        "optic nerve",
        "eye",
        "brain"
      ],
      "options": []
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L1::Q8",
      "moduleId": "rn_crVHckMJcJw7d56s::L1",
      "stem": "Explain why the blind spot is blind.",
      "misconceptionClass": "blind spot reasoning",
      "kind": "explain-why",
      "modelAnswer": "The blind spot is the point where the optic nerve exits the eye, and at that location there are no light receptor cells; any image falling there cannot be converted into impulses, so that region sends nothing to the brain.",
      "keywords": [
        "optic nerve",
        "receptor cells",
        "impulses",
        "brain"
      ],
      "options": []
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L1::Q9",
      "moduleId": "rn_crVHckMJcJw7d56s::L1",
      "stem": "A torch beam shines into a friend's eye. Order the journey: from the light entering to impulses leaving for the brain.",
      "misconceptionClass": "pathway application",
      "kind": "application",
      "modelAnswer": "Light passes through the cornea and pupil, is focused by the lens onto the retina, the retinal receptor cells are stimulated, and the resulting impulses leave along the optic nerve toward the brain.",
      "keywords": [
        "cornea",
        "pupil",
        "retina",
        "optic nerve"
      ],
      "options": []
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L2::Q1",
      "moduleId": "rn_crVHckMJcJw7d56s::L2",
