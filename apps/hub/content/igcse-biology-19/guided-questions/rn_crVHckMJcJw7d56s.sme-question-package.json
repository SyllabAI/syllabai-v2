      "misconceptionClass": "cornea function",
      "options": [
        {
          "key": "A",
          "text": "The blind spot",
          "correct": false,
          "explanation": "That region has no receptor cells at all.",
          "misconception": "role swapped"
        },
        {
          "key": "B",
          "text": "The cornea",
          "correct": true,
          "explanation": "The transparent curved cornea bends light on entry.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "The conjunctiva",
          "correct": false,
          "explanation": "It lubricates and protects.",
          "misconception": "role swapped"
        },
        {
          "key": "D",
          "text": "The fovea",
          "correct": false,
          "explanation": "The fovea handles detail vision, not refraction.",
          "misconception": "role swapped"
        }
      ]
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L2::Q2",
      "moduleId": "rn_crVHckMJcJw7d56s::L2",
      "stem": "What does the iris control?",
      "misconceptionClass": "iris function",
      "options": [
        {
          "key": "A",
          "text": "Carries impulses to the brain",
          "correct": false,
          "explanation": "The optic nerve does that.",
          "misconception": "role swapped"
        },
        {
          "key": "B",
          "text": "Lubricates the eyelids",
          "correct": false,
          "explanation": "The conjunctiva handles lubrication.",
          "misconception": "role swapped"
        },
        {
          "key": "C",
          "text": "Controls how much light enters the pupil",
          "correct": true,
          "explanation": "The iris meters the light admission.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Changes the shape of the lens",
          "correct": false,
          "explanation": "That is the ciliary muscle's task.",
          "misconception": "role swapped"
        }
      ]
    },
    {
      "id": "rn_crVHckMJcJw7d56s::L2::Q3",
