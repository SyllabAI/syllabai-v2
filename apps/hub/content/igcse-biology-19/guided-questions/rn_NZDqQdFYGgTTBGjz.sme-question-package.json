    {
      "id": "rn_NZDqQdFYGgTTBGjz::L1::Q7",
      "moduleId": "rn_NZDqQdFYGgTTBGjz::L1",
      "stem": "Name the chains whose holding bonds are disrupted by extreme pH.",
      "misconceptionClass": "chain recall",
      "kind": "recall",
