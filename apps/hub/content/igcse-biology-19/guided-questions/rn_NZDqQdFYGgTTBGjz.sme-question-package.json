  "questions": [
    {
      "id": "rn_NZDqQdFYGgTTBGjz::L1::Q1",
      "moduleId": "rn_NZDqQdFYGgTTBGjz::L1",
      "stem": "What is the optimum pH for most enzymes?",
      "misconceptionClass": "optimum pH value",
      "options": [
        {
          "key": "A",
          "text": "Around pH 7",
          "correct": true,
          "explanation": "Neutral pH suits most enzymes.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Around pH 2",
          "correct": false,
          "explanation": "That suits stomach enzymes specifically.",
          "misconception": "stomach value over-applied"
        },
        {
          "key": "C",
          "text": "Around pH 11",
          "correct": false,
          "explanation": "Strongly alkaline conditions denature most enzymes.",
          "misconception": "alkaline extreme misattributed"
        },
        {
          "key": "D",
          "text": "Enzymes have no optimum pH",
          "correct": false,
          "explanation": "Every enzyme has one.",
          "misconception": "optimum denied"
        }
      ]
    },
    {
      "id": "rn_NZDqQdFYGgTTBGjz::L1::Q2",
      "moduleId": "rn_NZDqQdFYGgTTBGjz::L1",
      "stem": "Why can a stomach enzyme and a duodenum enzyme have different optimum pH values?",
      "misconceptionClass": "location difference",
      "options": [
        {
          "key": "A",
          "text": "Because pH does not actually affect enzymes",
          "correct": false,
          "explanation": "pH affects them strongly.",
          "misconception": "effect denied"
        },
        {
          "key": "B",
          "text": "Because each is produced for the conditions of the place where it works",
          "correct": true,
          "explanation": "The note ties optima to the acidic or alkaline conditions of production site.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Because stomach enzymes are larger",
          "correct": false,
          "explanation": "Size plays no role.",
          "misconception": "size rule invented"
        },
        {
          "key": "D",
          "text": "Because duodenum enzymes are denatured by design",
          "correct": false,
          "explanation": "Designed denaturation makes no sense.",
          "misconception": "absurd mechanism"
        }
      ]
    },
    {
      "id": "rn_NZDqQdFYGgTTBGjz::L1::Q3",
      "moduleId": "rn_NZDqQdFYGgTTBGjz::L1",
      "stem": "What happens to an enzyme's activity as pH moves far from its optimum?",
      "misconceptionClass": "drift effect",
      "options": [
        {
          "key": "A",
          "text": "The enzyme becomes a different substrate",
          "correct": false,
          "explanation": "Enzymes never become substrates.",
          "misconception": "identity confusion"
        },
        {
          "key": "B",
          "text": "Only the colour of the solution changes",
          "correct": false,
          "explanation": "Colour is irrelevant to activity.",
          "misconception": "irrelevant variable"
        },
        {
          "key": "C",
          "text": "The active site changes shape, so the substrate no longer fits and activity stops",
          "correct": true,
          "explanation": "The shape-loss pathway is the pH mechanism.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Activity rises because the enzyme is stretched",
          "correct": false,
          "explanation": "Stretching distorts, it does not improve.",
          "misconception": "effect inverted"
        }
      ]
    },
    {
      "id": "rn_NZDqQdFYGgTTBGjz::L1::Q4",
      "moduleId": "rn_NZDqQdFYGgTTBGjz::L1",
      "stem": "Which wording should you use when writing about an enzyme that has lost its shape at extreme pH?",
      "misconceptionClass": "terminology",
      "options": [
        {
          "key": "A",
          "text": "The enzyme has died",
          "correct": false,
          "explanation": "Enzymes are molecules, not living things.",
          "misconception": "wrong verb"
        },
        {
          "key": "B",
          "text": "The enzyme has been killed",
          "correct": false,
          "explanation": "Same error in another word.",
          "misconception": "wrong verb"
        },
        {
          "key": "C",
          "text": "The enzyme has rested",
          "correct": false,
          "explanation": "Rest implies recovery that denaturation does not allow.",
          "misconception": "wrong verb"
        },
        {
          "key": "D",
          "text": "The enzyme has been denatured",
          "correct": true,
          "explanation": "The exam hint insists on 'denatured'.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_NZDqQdFYGgTTBGjz::L1::Q5",
      "moduleId": "rn_NZDqQdFYGgTTBGjz::L1",
      "stem": "Which pairing of location and optimum pH is correct?",
      "misconceptionClass": "location pairings",
      "options": [
        {
          "key": "A",
          "text": "Stomach — about pH 2; duodenum — about pH 8 or 9",
          "correct": true,
          "explanation": "Both pairings match the note.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Stomach — about pH 8; duodenum — about pH 2",
          "correct": false,
          "explanation": "The two are swapped.",
          "misconception": "values swapped"
        },
        {
          "key": "C",
          "text": "Stomach — pH 7; duodenum — pH 2",
          "correct": false,
          "explanation": "Neither pairing matches.",
          "misconception": "values invented"
        },
        {
          "key": "D",
          "text": "Stomach — pH 0; duodenum — pH 14",
          "correct": false,
          "explanation": "The extremes overstate both values.",
          "misconception": "values overstated"
        }
      ]
    },
    {
