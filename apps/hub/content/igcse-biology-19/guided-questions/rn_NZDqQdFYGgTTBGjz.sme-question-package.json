    },
    {
      "id": "rn_NZDqQdFYGgTTBGjz::L1::Q8",
      "moduleId": "rn_NZDqQdFYGgTTBGjz::L1",
      "stem": "Explain why moving a duodenum enzyme into the acid of the stomach would end its working life even if it were later returned to alkaline conditions.",
      "misconceptionClass": "acid excursion",
      "kind": "explain-why",
      "modelAnswer": "Far from its alkaline optimum the acidic pH disrupts the bonds holding the enzyme's shape, so its active site no longer complements its substrate; because that denaturation is irreversible, returning it to alkaline conditions cannot rebuild the working shape.",
      "keywords": [
        "optimum",
        "denaturation",
        "irreversible",
        "complements"
      ],
      "options": []
    },
    {
      "id": "rn_NZDqQdFYGgTTBGjz::L1::Q9",
      "moduleId": "rn_NZDqQdFYGgTTBGjz::L1",
      "stem": "An indigestion tablet neutralises excess stomach acid. Using this note, state what happens to stomach-enzyme activity and to a swallowed duodenum-type enzyme as the pH rises.",
      "misconceptionClass": "tablet application",
      "kind": "application",
      "modelAnswer": "The stomach enzyme drifts above its acidic optimum and loses activity as its site distorts, while a duodenum-type enzyme moves closer to ITS alkaline optimum and works better — same pH change, opposite outcomes, because optima are location-specific.",
      "keywords": [
        "optimum",
        "stomach",
        "duodenum",
        "activity"
      ],
      "options": []
    }
