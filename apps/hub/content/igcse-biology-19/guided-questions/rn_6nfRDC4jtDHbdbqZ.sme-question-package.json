    {
      "id": "rn_6nfRDC4jtDHbdbqZ::L1::Q1",
      "moduleId": "rn_6nfRDC4jtDHbdbqZ::L1",
      "stem": "Which steps prepare a solid food sample for testing?",
      "misconceptionClass": "sample preparation",
      "options": [
        {
          "key": "A",
          "text": "Crush it, stir it into distilled water, then filter the mixture",
          "correct": true,
          "explanation": "The note's four-step preparation ends with filtering the solution.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Boil it dry, then scrape the residue",
          "correct": false,
          "explanation": "No boiling-dry step exists.",
          "misconception": "invented step"
        },
        {
          "key": "C",
          "text": "Freeze it, then shave thin slices",
          "correct": false,
          "explanation": "No freezing step exists.",
          "misconception": "invented step"
        },
        {
          "key": "D",
          "text": "Test it whole, then filter afterwards",
          "correct": false,
          "explanation": "Testing happens on the filtered solution.",
          "misconception": "order wrong"
        }
      ]
    },
    {
