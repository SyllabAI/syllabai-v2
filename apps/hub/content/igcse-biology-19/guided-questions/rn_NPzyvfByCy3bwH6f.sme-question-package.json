        {
          "key": "C",
          "text": "Nucleus, cytoplasm, membrane",
          "correct": false,
          "explanation": "Those are shared.",
          "misconception": "shared traits misfiled"
        },
        {
          "key": "D",
          "text": "Mitochondria, ribosomes, cell wall",
          "correct": false,
          "explanation": "Mitochondria and ribosomes are shared.",
          "misconception": "shared trait misfiled"
        }
      ]
    },
