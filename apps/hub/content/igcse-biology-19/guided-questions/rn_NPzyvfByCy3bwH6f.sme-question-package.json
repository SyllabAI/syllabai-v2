      "options": [
        {
          "key": "A",
          "text": "Because the wall digests water",
          "correct": false,
          "explanation": "Walls do not digest anything.",
          "misconception": "mechanism invented"
        },
        {
          "key": "B",
          "text": "Because chloroplasts store water",
          "correct": false,
          "explanation": "Chloroplasts handle light.",
          "misconception": "function mismatch"
        },
        {
          "key": "C",
          "text": "Because the nucleus pumps water",
          "correct": false,
          "explanation": "No pumping role is described.",
          "misconception": "mechanism invented"
        },
        {
          "key": "D",
          "text": "The sap presses the cytoplasm outward onto the wall",
          "correct": true,
          "explanation": "The note states this pressing mechanism.",
          "misconception": null
        }
      ]
    },
    {
