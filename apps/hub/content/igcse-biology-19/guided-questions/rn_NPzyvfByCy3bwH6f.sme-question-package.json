    {
      "id": "rn_NPzyvfByCy3bwH6f::L2::Q9",
      "moduleId": "rn_NPzyvfByCy3bwH6f::L2",
      "stem": "A pondweed sample's cells look flaccid under the microscope after salt water is added. Using the plant-cell structures, explain the observation.",
      "misconceptionClass": "turgor application",
      "kind": "application",
      "modelAnswer": "Salt water draws water out, so the permanent vacuole loses cell sap and stops pressing the cytoplasm against the cellulose wall — the cell goes flaccid, showing the vacuole's turgor role.",
      "keywords": [
        "vacuole",
        "turgid",
