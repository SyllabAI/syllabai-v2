    {
      "id": "rn_NPzyvfByCy3bwH6f::L1::Q1",
      "moduleId": "rn_NPzyvfByCy3bwH6f::L1",
      "stem": "Which structure holds the genetic material of an animal cell?",
      "misconceptionClass": "nucleus function",
      "options": [
        {
          "key": "A",
          "text": "The nucleus",
          "correct": true,
          "explanation": "The nucleus contains the genetic material.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The cytoplasm",
          "correct": false,
          "explanation": "Cytoplasm hosts reactions, not the genome.",
          "misconception": "function mismatch"
        },
        {
          "key": "C",
          "text": "The cell membrane",
          "correct": false,
          "explanation": "The membrane controls entry and exit.",
          "misconception": "function mismatch"
        },
        {
          "key": "D",
          "text": "Ribosomes",
          "correct": false,
          "explanation": "Ribosomes build proteins.",
          "misconception": "function mismatch"
        }
      ]
    },
    {
      "id": "rn_NPzyvfByCy3bwH6f::L1::Q2",
      "moduleId": "rn_NPzyvfByCy3bwH6f::L1",
      "stem": "Which structure is the site of aerobic respiration?",
      "misconceptionClass": "mitochondria function",
      "options": [
        {
          "key": "A",
          "text": "Ribosomes",
          "correct": false,
          "explanation": "Ribosomes make proteins.",
          "misconception": "function mismatch"
        },
        {
          "key": "B",
          "text": "Mitochondria",
          "correct": true,
          "explanation": "Mitochondria carry out aerobic respiration.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "The nucleus",
          "correct": false,
          "explanation": "The nucleus stores genetic material.",
          "misconception": "function mismatch"
        },
        {
          "key": "D",
          "text": "The vacuole",
          "correct": false,
          "explanation": "Animal cells lack the permanent vacuole.",
          "misconception": "structure misplaced"
        }
      ]
    },
    {
      "id": "rn_NPzyvfByCy3bwH6f::L1::Q3",
      "moduleId": "rn_NPzyvfByCy3bwH6f::L1",
      "stem": "What does the cell membrane do?",
      "misconceptionClass": "membrane function",
      "options": [
        {
          "key": "A",
          "text": "Absorbs light for photosynthesis",
          "correct": false,
          "explanation": "That is the chloroplast's job.",
          "misconception": "function mismatch"
        },
        {
          "key": "B",
          "text": "Makes protein",
          "correct": false,
          "explanation": "Protein synthesis happens on ribosomes.",
          "misconception": "function mismatch"
        },
        {
          "key": "C",
          "text": "Controls what enters and leaves the cell",
          "correct": true,
          "explanation": "The membrane is the gatekeeper.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Stores cell sap",
          "correct": false,
          "explanation": "Cell sap sits in the plant vacuole.",
          "misconception": "plant structure misplaced"
        }
      ]
    },
