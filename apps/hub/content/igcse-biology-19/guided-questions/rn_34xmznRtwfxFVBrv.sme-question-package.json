  "questions": [
    {
      "id": "rn_34xmznRtwfxFVBrv::L1::Q1",
      "moduleId": "rn_34xmznRtwfxFVBrv::L1",
      "stem": "What does cell differentiation produce?",
      "misconceptionClass": "differentiation outcome",
      "options": [
        {
          "key": "A",
          "text": "Specialised cells with structures fitted to particular functions",
          "correct": true,
          "explanation": "Specialisation is the outcome of differentiation.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "More copies of the same unspecialised cell",
          "correct": false,
          "explanation": "That is mitosis without differentiation.",
          "misconception": "process confusion"
        },
        {
          "key": "C",
          "text": "Cells that lose all their organelles",
          "correct": false,
          "explanation": "Differentiation remakes structure, it does not strip it.",
          "misconception": "outcome inverted"
        },
        {
          "key": "D",
          "text": "Genetically new organisms",
          "correct": false,
          "explanation": "Differentiation changes structure, not genome.",
          "misconception": "scale confusion"
        }
      ]
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L1::Q2",
      "moduleId": "rn_34xmznRtwfxFVBrv::L1",
      "stem": "What are stem cells?",
      "misconceptionClass": "stem cell definition",
      "options": [
        {
          "key": "A",
          "text": "Cells that cannot divide",
          "correct": false,
          "explanation": "They divide by mitosis.",
          "misconception": "property denied"
        },
        {
          "key": "B",
          "text": "Undifferentiated cells that divide by mitosis into stem cells or specialised cells",
          "correct": true,
          "explanation": "The note's definition.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Cells that have finished differentiating",
          "correct": false,
          "explanation": "Stem cells are undifferentiated.",
          "misconception": "status inverted"
        },
        {
          "key": "D",
          "text": "Cells found only in plants",
          "correct": false,
          "explanation": "Animals carry them too.",
          "misconception": "scope wrong"
        }
      ]
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L1::Q3",
      "moduleId": "rn_34xmznRtwfxFVBrv::L1",
      "stem": "When do most ANIMAL cells differentiate?",
      "misconceptionClass": "animal timing",
      "options": [
        {
          "key": "A",
          "text": "Only during repair",
          "correct": false,
          "explanation": "Repair is the adult stem cell's job.",
          "misconception": "role confusion"
        },
        {
          "key": "B",
          "text": "Never — animal cells are born specialised",
          "correct": false,
          "explanation": "They differentiate early.",
          "misconception": "denial wrong"
        },
        {
          "key": "C",
          "text": "At an early stage of development",
          "correct": true,
          "explanation": "Early differentiation is the animal pattern.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Continuously throughout life",
          "correct": false,
          "explanation": "That is the plant pattern.",
          "misconception": "timing swapped"
        }
      ]
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L1::Q4",
      "moduleId": "rn_34xmznRtwfxFVBrv::L1",
      "stem": "What do adult stem cells mainly do?",
      "misconceptionClass": "adult stem role",
      "options": [
        {
          "key": "A",
          "text": "Build the whole body from scratch",
          "correct": false,
          "explanation": "That happened during early development.",
          "misconception": "timing confusion"
        },
        {
          "key": "B",
          "text": "Photosynthesise",
          "correct": false,
          "explanation": "Wrong kingdom entirely.",
          "misconception": "kingdom error"
        },
        {
          "key": "C",
          "text": "Nothing — they are inactive",
          "correct": false,
          "explanation": "They actively maintain tissues.",
          "misconception": "activity denied"
        },
        {
          "key": "D",
          "text": "Replace and repair damaged cells throughout life",
          "correct": true,
          "explanation": "The note gives replacing and repairing as their role.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L1::Q5",
      "moduleId": "rn_34xmznRtwfxFVBrv::L1",
      "stem": "Which kingdom keeps cells able to fully differentiate throughout life?",
      "misconceptionClass": "plant ability",
      "options": [
        {
          "key": "A",
          "text": "Plants",
          "correct": true,
          "explanation": "Many plant cells retain full differentiation ability.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Animals",
          "correct": false,
          "explanation": "Animal cells lose the ability early.",
          "misconception": "timing swapped"
        },
        {
          "key": "C",
          "text": "Bacteria",
          "correct": false,
          "explanation": "Not the frame of this note.",
          "misconception": "scope wrong"
        },
        {
          "key": "D",
          "text": "Viruses",
          "correct": false,
          "explanation": "Not living organisms.",
          "misconception": "kingdom error"
        }
      ]
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L1::Q6",
      "moduleId": "rn_34xmznRtwfxFVBrv::L1",
      "stem": "Define cell differentiation in one sentence.",
      "misconceptionClass": "definition recall",
      "kind": "recall",
      "modelAnswer": "The process that turns an unspecialised cell into a specialised one.",
      "keywords": [
        "differentiation",
        "specialised",
        "unspecialised",
        "process"
      ],
      "options": []
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L1::Q7",
      "moduleId": "rn_34xmznRtwfxFVBrv::L1",
      "stem": "Name the undifferentiated cells that divide by mitosis.",
      "misconceptionClass": "stem recall",
      "kind": "recall",
      "modelAnswer": "Stem cells.",
      "keywords": [
