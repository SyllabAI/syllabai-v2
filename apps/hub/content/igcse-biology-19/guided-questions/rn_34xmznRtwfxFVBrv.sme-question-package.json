    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L1::Q8",
      "moduleId": "rn_34xmznRtwfxFVBrv::L1",
      "stem": "Explain why a nerve cell needs an elongated structure built during differentiation.",
      "misconceptionClass": "nerve shape reasoning",
      "kind": "explain-why",
      "modelAnswer": "A nerve cell's job is carrying impulses between distant body parts, so its cytoplasm and membrane elongate into long connections during differentiation; the length is the structure that lets signals reach their targets.",
      "keywords": [
        "elongate",
        "impulses",
        "differentiation",
        "connections"
      ],
      "options": []
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L1::Q9",
      "moduleId": "rn_34xmznRtwfxFVBrv::L1",
      "stem": "A gardener takes a cutting and new roots sprout from the stem. Using differentiation timing, explain why the cutting works for the plant but an equivalent would fail for a salamander's lost limb.",
      "misconceptionClass": "cutting application",
      "kind": "application",
      "modelAnswer": "Plant cells can still fully differentiate late in life, so stem cells in the cutting rebuild root tissue; most animal cells differentiated early and lost that ability, so regrowth depends on limited stem-cell repair rather than full re-differentiation.",
      "keywords": [
        "differentiate",
        "stem cells",
        "repair",
        "differentiation"
      ],
      "options": []
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L2::Q1",
      "moduleId": "rn_34xmznRtwfxFVBrv::L2",
      "stem": "Where do ciliated cells carry out their transport job?",
      "misconceptionClass": "cilia location",
      "options": [
        {
          "key": "A",
          "text": "In the soil around roots",
          "correct": false,
          "explanation": "Absurd for animal cells.",
          "misconception": "absurd option"
        },
        {
          "key": "B",
          "text": "In the trachea and bronchi",
          "correct": true,
          "explanation": "The named airway locations.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "In the heart's chambers",
          "correct": false,
          "explanation": "Not the named site.",
          "misconception": "location invented"
        },
        {
          "key": "D",
          "text": "In the leaf's palisade layer",
          "correct": false,
          "explanation": "That is plant tissue.",
          "misconception": "kingdom error"
        }
      ]
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L2::Q2",
      "moduleId": "rn_34xmznRtwfxFVBrv::L2",
      "stem": "What do the cilia do?",
      "misconceptionClass": "cilia function",
      "options": [
        {
          "key": "A",
          "text": "Conduct electrical impulses",
          "correct": false,
          "explanation": "That is the nerve cell's job.",
          "misconception": "function mismatch"
        },
        {
          "key": "B",
          "text": "Store haemoglobin",
          "correct": false,
          "explanation": "That is the red blood cell's cargo.",
          "misconception": "function mismatch"
        },
        {
          "key": "C",
          "text": "Beat to transport mucus and trapped particles along the airways",
          "correct": true,
          "explanation": "Cilia beat in unison to move mucus.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Absorb oxygen directly from air",
          "correct": false,
          "explanation": "Oxygen exchange happens in the lungs' alveoli.",
          "misconception": "function mismatch"
        }
      ]
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L2::Q3",
      "moduleId": "rn_34xmznRtwfxFVBrv::L2",
      "stem": "Why does the fatty sheath matter for a nerve cell?",
