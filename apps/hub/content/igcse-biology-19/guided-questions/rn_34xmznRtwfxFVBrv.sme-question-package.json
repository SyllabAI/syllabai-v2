          "text": "It stayed unspecialised on purpose",
          "correct": false,
          "explanation": "Contradiction.",
          "misconception": "status confusion"
        },
        {
          "key": "B",
          "text": "Its biconcave shape and haemoglobin-packed cytoplasm are the specialised structures its transport function needs",
          "correct": true,
          "explanation": "Structure follows the specialised function.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "It keeps the ability to become any other cell",
          "correct": false,
          "explanation": "It is already specialised.",
          "misconception": "status inverted"
