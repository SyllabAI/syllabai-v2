        }
      ]
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L3::Q4",
      "moduleId": "rn_34xmznRtwfxFVBrv::L3",
      "stem": "How is the red blood cell's design an example of differentiation?",
      "misconceptionClass": "design origin",
      "options": [
        {
