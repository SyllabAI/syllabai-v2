    {
      "id": "rn_34xmznRtwfxFVBrv::L2::Q9",
      "moduleId": "rn_34xmznRtwfxFVBrv::L2",
      "stem": "A smoker's airways lose ciliated cells to damage. Using the specialist's function, predict two consequences in the trachea.",
      "misconceptionClass": "smoker application",
      "kind": "application",
      "modelAnswer": "Mucus is no longer swept upward, so it accumulates in the airways, and trapped particles and pathogens linger longer — the clearing service its cilia provided is gone.",
      "keywords": [
        "mucus",
        "cilia",
        "trapped",
