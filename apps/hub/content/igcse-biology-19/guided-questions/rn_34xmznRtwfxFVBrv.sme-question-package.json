      "options": [
        {
          "key": "A",
          "text": "It digests the impulses",
          "correct": false,
          "explanation": "Impulses are conducted, not digested.",
          "misconception": "function invented"
        },
        {
          "key": "B",
          "text": "It stores oxygen",
          "correct": false,
          "explanation": "Wrong cargo.",
          "misconception": "function mismatch"
        },
        {
          "key": "C",
          "text": "It beats like cilia",
          "correct": false,
          "explanation": "Different structure entirely.",
          "misconception": "function mismatch"
        },
        {
          "key": "D",
          "text": "It insulates the axon and speeds up transmission",
          "correct": true,
          "explanation": "Insulation and speed are the sheath's roles.",
          "misconception": null
        }
      ]
    },
    {
