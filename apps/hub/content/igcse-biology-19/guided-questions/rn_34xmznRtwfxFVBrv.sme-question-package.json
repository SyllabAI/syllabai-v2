    {
      "id": "rn_34xmznRtwfxFVBrv::L3::Q8",
      "moduleId": "rn_34xmznRtwfxFVBrv::L3",
      "stem": "Explain why packing red cells with haemoglobin is not enough without the shape advantage.",
      "misconceptionClass": "cargo plus shape",
      "kind": "explain-why",
      "modelAnswer": "Haemoglobin sets the loading capacity, but the gas still must cross the membrane quickly; the biconcave shape supplies the exchange surface and short diffusion paths, so cargo and geometry only work together.",
      "keywords": [
        "haemoglobin",
        "surface",
        "membrane",
        "biconcave"
      ],
      "options": []
    },
    {
      "id": "rn_34xmznRtwfxFVBrv::L3::Q9",
      "moduleId": "rn_34xmznRtwfxFVBrv::L3",
      "stem": "An athlete trains at altitude and blood tests show more red blood cells. Using the specialist's design, explain the benefit.",
      "misconceptionClass": "altitude application",
      "kind": "application",
      "modelAnswer": "More cells mean more biconcave surfaces and more total haemoglobin, so the blood's oxygen-carrying capacity rises — the fleet grows bigger while each cell keeps the same efficient design.",
      "keywords": [
        "haemoglobin",
        "capacity",
        "design",
        "biconcave"
      ],
      "options": []
    },
