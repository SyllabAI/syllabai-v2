# syllabai-hub — public runtime configuration (T-MIG-011 reference sheet)
#
# The hub is a strangler-fig client: per-surface env switches decide whether a
# request goes to the frozen Java core (Render) or the syllabai-v2 api
# (Vercel). All values are NON-SECRET and inlined at BUILD time — changing
# one requires a redeploy (core docs/DEPLOYMENT.md doctrine).

# ── Frozen Java core (Render) ────────────────────────────────────────────────
# Bare origin, NO trailing /api/v1 (a trailing prefix is normalized away by
# apiPath()). Empty/unset = relative same-origin request paths (legacy demo
# behaviour with the XTransformPort fallback).
# Production value today: https://syllabai-core.onrender.com
NEXT_PUBLIC_API_BASE_URL=

# ── syllabai-v2 api (Vercel) ─────────────────────────────────────────────────
# Bare origin of the v2 api. When set, ONLY the surface prefixes listed in
# apps/hub/src/lib/api.ts (V2_SURFACE_PREFIXES — Wave 1: /api/v1/auth, after
# T-MIG-010's golden gate passes on a branch deployment) route here; every
# other surface keeps using NEXT_PUBLIC_API_BASE_URL. Unsetting this var
# reverts the whole app to the core in one redeploy — that is the entire
# rollback plan (MIGRATION_PLAN §7). At cutover (Wave 7) this value is
# promoted to NEXT_PUBLIC_API_BASE_URL and the core is retired.
NEXT_PUBLIC_API_V2_BASE_URL=

# ── Server-side core origin (only for /api/ai + server proxies) ─────────────
# Server-only; wins over NEXT_PUBLIC_API_BASE_URL inside core-proxy.ts.
# Not exposed to the browser bundle.
SYLLABAI_CORE_BASE_URL=

# ── Data mode (demo fallback doctrine, hub ARCHITECTURE.md) ─────────────────
# DEMO_DATA_MODE=mock|core-api|neon — explicit selection wins over the
# env-detection order; unprovisioned surfaces degrade to the bundled corpus
# WITH a visible banner, never silently.
# DEMO_DATA_MODE=

# ── Nightly decay cron (T-MIG-042-PREP scaffold — INERT until Wave-7 cutover) ─
# Vercel Cron (vercel.json) hits GET /api/cron/nightly-decay daily (02:00 UTC
# placeholder — exact hour confirmed from V38/@Scheduled at the Wave-4 port).
# CRON_SECRET: when set on the Vercel project, Vercel sends
# "Authorization: Bearer $CRON_SECRET"; the route fails closed (401) without a
# matching bearer. UNSET = the endpoint refuses every invocation.
# CRON_SECRET=
#
# DECAY_CRON_ENABLED: must be exactly "1" to leave the skip-gate. Default OFF —
# BASELINE_DB §4.3: the Java core's scheduler owns decay until the Wave-7
# cutover; enabling early risks DOUBLE-DECAY against the same branch (a
# correctness bug, not a perf bug). Even when enabled, the wiring seam returns
# not-implemented (501) until the Wave-4 decay port (T-MIG-042) lands.
# DECAY_CRON_ENABLED=
