{
  "name": "syllabai-v2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "bun test apps/api packages",
    "build:api": "turbo run build --filter=@syllabai/api",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:hub": "bun run --cwd apps/hub dev",
    "build:hub": "turbo run build --filter=@syllabai/hub",
    "golden": "bun golden/runner.ts"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.3.14"
    }
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "turbo": "^2.11.10"
  }
}
